{
  "name": "baynavigator",
  "type": "module",
  "version": "2.0.0",
  "description": "Bay Area community resources - Free and low-cost programs",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "generate-api": "node scripts/generate/generate-api.cjs && node scripts/generate/generate-geojson.cjs && node scripts/generate/generate-refinement-json.cjs && node scripts/generate/generate-search-index.cjs",
    "generate:refinement": "node scripts/generate/generate-refinement-json.cjs",
    "generate:search": "node scripts/generate/generate-search-index.cjs",
    "setup": "node scripts/util/setup.cjs",
    "sync:meilisearch": "node scripts/sync/sync-meilisearch.cjs",
    "verify:gate": "node scripts/validate/verify-gate.cjs",
    "test": "npx playwright test",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:unit:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 80 --functions 80 --branches 70 node --test tests/unit/*.test.cjs",
    "test:a11y": "npx playwright test --project=accessibility --project=accessibility-mobile",
    "test:all": "npm run test:unit && npm run test",
    "validate:data": "node scripts/validate/validate-data.cjs",
    "validate:freshness": "node scripts/check/check-data-freshness.cjs",
    "validate:links": "node scripts/validate/validate-links.cjs --report",
    "generate:simple": "node scripts/generate/generate-simple-language-descriptions.cjs",
    "categorize": "node scripts/util/categorize-program.cjs",
    "diagnose:carl": "node scripts/util/diagnose-carl.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "bay-area",
    "community",
    "resources",
    "assistance"
  ],
  "author": "Bay Tides",
  "license": "MIT",
  "dependencies": {
    "@astrojs/react": "^5.0.3",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.8",
    "astro-compress": "^2.4.1",
    "fuse.js": "^7.3.0",
    "js-yaml": "^4.1.1",
    "motion": "^12.38.0",
    "playwright": "^1.59.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2"
  },
  "overrides": {
    "devalue": "^5.6.2",
    "h3": "^1.15.5",
    "minimatch": ">=10.2.1",
    "svgo": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.1",
    "adm-zip": "^0.5.17",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "c8": "^10.1.3",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "string-similarity": "^4.0.4",
    "yaml": "^2.8.3"
  }
}
