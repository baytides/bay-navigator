---
/**
 * SiteLayout — the rebuilt page shell.
 *
 * Replaces BaseLayout (1,889 lines that accumulated a sports-theme engine, four
 * font systems and three banner components) with the minimum a page actually
 * needs. Accessibility is structural here rather than bolted on:
 *
 *   - one <h1> per page, landmarks on every region, skip link first in the DOM
 *   - theme is resolved before first paint so there is no flash and no layout
 *     shift for people who set a preference
 *   - every interactive target is >= 44x44 (WCAG 2.5.5 AAA)
 *   - the header does not trap focus or move on scroll; motion respects
 *     prefers-reduced-motion
 */
// global.css pulls in Tailwind AND the design system. Importing only the design
// system here silently stripped every utility class from pages that still use
// them — w-4 h-4 icons rendered at 1125px, which is what an unstyled SVG does
// inside a flex parent.
import '../styles/global.css';
// Not decoration for this audience: SafetyExit is the escape hatch for someone
// browsing from an unsafe home, and the language selector covers ten languages
// in a region where a quarter of households speak English less than "very well".
import SafetyExit from '../components/SafetyExit.astro';
import LanguageSelector from '../components/LanguageSelector.astro';
import OfflineBanner from '../components/OfflineBanner.astro';
// Resolves every data-i18n attribute on the page against the locale bundles.
// Without it the language selector above is decorative: it writes the chosen
// locale to localStorage and nothing ever reads it back. BaseLayout mounted
// this and SiteLayout did not, so each page converted to the new layout
// silently lost translation.
import I18nLoader from '../components/i18n-loader.astro';
// Site furniture that only existed in BaseLayout, so no page on the new layout
// had it. AlertBanner is the one that matters: it carries live missing-person
// alerts (the feed syncs hourly via GitHub Actions and was 6 minutes old when
// checked), and the homepage was showing none of them.
// Deliberately NOT carried over from BaseLayout:
//   Toast              nothing in the codebase dispatches to it
//   ProgramDetailModal the directory links to full program pages now
//   SmartAssistant     Carl's chat window was retired in September 2026
import AlertBanner from '../components/AlertBanner.astro';
import PWAInstallBanner from '../components/PWAInstallBanner.astro';
import PrintQR from '../components/PrintQR.astro';
import {
  DEFAULT_DESCRIPTION,
  absoluteImageUrl,
  canonicalUrl,
  organizationSchema,
  websiteSchema,
} from '../lib/structured-data';

interface Props {
  title: string;
  description?: string;
  /** Set false on the homepage, where the <h1> is the hero. */
  showBreadcrumb?: boolean;
  breadcrumb?: Array<{ label: string; href?: string }>;
  /** Open Graph image path, resolved against the site origin. */
  image?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD emitted alongside the site-wide Organization and WebSite. */
  schemas?: Record<string, unknown>[];
  /** Keep the page out of search indexes (utility pages, not content). */
  noindex?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  breadcrumb = [],
  image = '/og-image.png',
  type = 'website',
  schemas = [],
  noindex = false,
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname);
const ogImage = absoluteImageUrl(image);

const fullTitle = title === 'Home' ? 'Bay Navigator' : `${title} · Bay Navigator`;

const nav = [
  { label: 'Find programs', href: '/directory' },
  { label: 'Check eligibility', href: '/eligibility' },
  { label: 'Transit', href: '/transit' },
  { label: 'Alerts', href: '/alerts' },
  { label: 'About', href: '/about' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="color-scheme" content="light dark" />

    {
      /* This block did not exist. SiteLayout emitted a title and a description
        and nothing else, so each page moved onto it lost its canonical URL,
        its social card and its structured data — the homepage included. */
    }
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Bay Navigator" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema(description))} />
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    {
      /* Resolve theme before paint. Inline and synchronous on purpose: a
        deferred script would let the wrong theme render first. */
    }
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          /* private mode: fall through to the light default */
        }
      })();
    </script>
  </head>

  <body class="ds">
    <a href="#main" class="site-skip">Skip to main content</a>

    {/* Above the masthead, as in BaseLayout: an active alert outranks the nav. */}
    <AlertBanner />

    <header class="site-header">
      <div class="ds-shell site-header__inner">
        <a href="/" class="site-brand">
          <img
            src="/assets/images/logo/logo.webp"
            alt="Bay Navigator"
            class="site-brand__logo"
            width="40"
            height="40"
            decoding="async"
          />
          <span class="site-brand__name">Bay Navigator</span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <LanguageSelector />

        <button id="theme-toggle" type="button" class="site-icon-btn" aria-pressed="false">
          <span class="ds-visually-hidden">Use dark theme</span>
          <svg
            class="site-icon-btn__sun"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4"
              stroke-linecap="round"></path>
          </svg>
          <svg
            class="site-icon-btn__moon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </header>

    {
      breadcrumb.length > 0 && (
        <nav class="site-breadcrumb" aria-label="Breadcrumb">
          <div class="ds-shell">
            <ol>
              <li>
                <a href="/">Home</a>
              </li>
              {breadcrumb.map((c) => (
                <li>
                  {c.href ? (
                    <a href={c.href}>{c.label}</a>
                  ) : (
                    <span aria-current="page">{c.label}</span>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )
    }

    <main id="main">
      <slot />
    </main>

    <SafetyExit />
    <OfflineBanner />
    <PWAInstallBanner />
    <PrintQR />
    <I18nLoader />

    <footer class="site-footer">
      <div class="ds-shell site-footer__inner">
        <div>
          <p class="site-footer__brand">Bay Navigator</p>
          <p class="site-footer__note">
            A community-maintained directory of free and low-cost help across the nine Bay Area
            counties. Open source, no tracking, no ads.
          </p>
        </div>
        <nav aria-label="Footer">
          <ul class="site-footer__links">
            <li><a href="/directory">Find programs</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/accessibility">Accessibility</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/feedback">Feedback</a></li>
          </ul>
        </nav>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      const root = document.documentElement;

      function sync() {
        const dark = root.classList.contains('dark');
        toggle?.setAttribute('aria-pressed', String(dark));
        const label = toggle?.querySelector('.ds-visually-hidden');
        if (label) label.textContent = dark ? 'Use light theme' : 'Use dark theme';
      }

      toggle?.addEventListener('click', () => {
        root.classList.toggle('dark');
        try {
          localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
        } catch {
          /* private mode: the choice just will not persist */
        }
        sync();
      });

      sync();
    </script>

    <style>
      .site-skip {
        position: absolute;
        left: var(--ds-gap);
        top: -4rem;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--ds-focus);
        color: var(--ds-focus-ink);
        border-radius: 0;
        font-weight: 650;
        text-decoration: none;
        transition: top var(--ds-dur) var(--ds-ease);
      }
      .site-skip:focus {
        top: 0;
      }

      /* A thick accent rule instead of a shadow. It survives high-contrast
         mode, prints, and a bad phone screen, none of which a shadow does. */
      .site-header {
        /* Was an 8px brand stripe — the GOV.UK masthead rule. At that weight it
           competes with the page title instead of separating the header from
           it, and it reads as a mis-set border rather than a deliberate mark.
           A 3px accent plus a hairline and a contact shadow does the same job
           of anchoring the header without shouting. */
        border-bottom: 3px solid var(--ds-brand);
        box-shadow: var(--ds-shadow-sm);
        background: var(--ds-bg);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        gap: var(--ds-gap-md);
        min-height: 4.25rem;
      }

      .site-brand {
        display: inline-flex;
        align-items: center;
        gap: var(--ds-gap-xs);
        min-height: var(--ds-tap);
        color: var(--ds-text);
        font-weight: 750;
        font-size: var(--ds-text-lg);
        text-decoration: none;
        margin-inline-end: auto;
      }
      .site-brand__logo {
        width: 2.5rem;
        height: 2.5rem;
        object-fit: contain;
        flex: 0 0 auto;
      }

      .site-nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ds-gap-2xs);
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .site-nav a {
        display: inline-flex;
        align-items: center;
        min-height: var(--ds-tap);
        padding-inline: 0.75rem;
        border-radius: var(--ds-radius-sm);
        color: var(--ds-text-muted);
        font-size: var(--ds-text-sm);
        font-weight: 600;
        text-decoration: none;
      }
      .site-nav a:hover {
        background: var(--ds-surface-2);
        color: var(--ds-text);
      }
      /* Current page is marked by weight AND a rule, never colour alone (1.4.1). */
      .site-nav a[aria-current='page'] {
        color: var(--ds-text);
        box-shadow: inset 0 -4px 0 var(--ds-text);
        border-radius: 0;
      }
      @media (max-width: 52rem) {
        .site-nav {
          order: 3;
          width: 100%;
          border-top: 1px solid var(--ds-border-soft);
          padding-block: var(--ds-gap-2xs);
        }
        .site-nav ul {
          overflow-x: auto;
          flex-wrap: nowrap;
        }
        .site-header__inner {
          flex-wrap: wrap;
          padding-block: var(--ds-gap-xs);
        }
      }

      .site-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--ds-tap);
        height: var(--ds-tap);
        border-radius: var(--ds-radius-sm);
        border: 1px solid var(--ds-border);
        background: var(--ds-bg);
        color: var(--ds-text);
        cursor: pointer;
      }
      .site-icon-btn:hover {
        background: var(--ds-surface-2);
      }
      .site-icon-btn__moon {
        display: none;
      }
      :global(.dark) .site-icon-btn__sun {
        display: none;
      }
      :global(.dark) .site-icon-btn__moon {
        display: block;
      }

      .site-breadcrumb {
        border-bottom: 1px solid var(--ds-border-soft);
        background: var(--ds-surface);
      }
      .site-breadcrumb ol {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ds-gap-xs);
        margin: 0;
        padding-block: var(--ds-gap-xs);
        list-style: none;
        font-size: var(--ds-text-xs);
        color: var(--ds-text-muted);
      }
      .site-breadcrumb li + li::before {
        content: '/';
        margin-inline-end: var(--ds-gap-xs);
        color: var(--ds-text-muted);
      }
      .site-breadcrumb a {
        color: var(--ds-brand-strong);
        min-height: 2rem;
        display: inline-flex;
        align-items: center;
      }

      .site-footer {
        margin-block-start: var(--ds-gap-2xl);
        border-top: 1px solid var(--ds-border-soft);
        background: var(--ds-surface);
      }
      .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--ds-gap-lg);
        padding-block: var(--ds-gap-xl);
      }
      .site-footer__brand {
        font-weight: 750;
        margin: 0 0 var(--ds-gap-2xs);
      }
      .site-footer__note {
        color: var(--ds-text-muted);
        font-size: var(--ds-text-sm);
        margin: 0;
      }
      .site-footer__links {
        display: grid;
        gap: var(--ds-gap-2xs);
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .site-footer__links a {
        display: inline-flex;
        align-items: center;
        min-height: var(--ds-tap);
        color: var(--ds-text);
        font-size: var(--ds-text-sm);
        font-weight: 600;
      }
    </style>
  </body>
</html>
