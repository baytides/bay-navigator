---
/**
 * CategoryCard — a single category link card for the homepage.
 * Renders icon, title, subtitle, optional inline tip, and links to the directory.
 */
interface Props {
  title: string;
  subtitle: string;
  count: number;
  href: string;
  color: string; // Tailwind color name: red, primary, rose, amber, indigo
  icon: string; // SVG path(s) for the icon
  tip?: string; // Optional actionable tip shown inline
  tipHref?: string; // Optional link for the tip
  tipPhone?: string; // Optional phone number for the tip
  i18nKey?: string;
  wide?: boolean; // span 2 columns on lg
}

const { title, subtitle, count, href, color, icon, tip, tipHref, tipPhone, i18nKey, wide } =
  Astro.props;

// Map color names to Tailwind classes
const colorMap: Record<string, { border: string; icon: string }> = {
  red: { border: 'border-l-red-500', icon: 'text-red-500' },
  primary: { border: 'border-l-primary-600', icon: 'text-primary-700 dark:text-primary-400' },
  rose: { border: 'border-l-rose-500', icon: 'text-rose-500' },
  amber: { border: 'border-l-amber-500', icon: 'text-amber-500' },
  indigo: { border: 'border-l-indigo-500', icon: 'text-indigo-600 dark:text-indigo-400' },
};

const colors = colorMap[color] || colorMap.primary;
---

<a
  href={href}
  class:list={[
    'category-card group block text-left rounded-xl border-l-4 border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 p-4 hover:border-primary-300 dark:hover:border-primary-600 hover:shadow-md transition-all no-underline focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-900',
    colors.border,
    wide ? 'lg:col-span-2' : '',
  ]}
>
  <div class="flex items-start gap-3">
    <div class="flex-shrink-0 mt-0.5" aria-hidden="true">
      <svg
        class:list={['w-6 h-6', colors.icon]}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <Fragment set:html={icon} />
      </svg>
    </div>
    <div class="min-w-0">
      <div
        class="font-semibold text-neutral-900 dark:text-white text-sm group-hover:text-primary-700 dark:group-hover:text-primary-300 transition-colors"
        data-i18n={i18nKey}
      >
        {title}
      </div>
      <div class="text-xs text-neutral-600 dark:text-neutral-300 mt-0.5">
        {subtitle} &middot; {count} programs
      </div>
    </div>
  </div>

  {
    tip && (
      <div class="mt-3 pt-2 border-t border-neutral-100 dark:border-neutral-700 text-xs text-neutral-700 dark:text-neutral-300">
        <span>{tip}</span>
        {tipHref && (
          <a
            href={tipHref}
            target="_blank"
            rel="noopener"
            class="font-semibold text-primary-700 dark:text-primary-400 hover:underline ml-1"
            onclick="event.stopPropagation()"
          >
            Learn more →
          </a>
        )}
        {tipPhone && (
          <a
            href={`tel:${tipPhone.replace(/[^0-9+]/g, '')}`}
            class="font-semibold text-primary-700 dark:text-primary-400 hover:underline ml-1"
            onclick="event.stopPropagation()"
          >
            {tipPhone}
          </a>
        )}
      </div>
    )
  }
</a>
