  // Build sports context from pre-loaded JSON data
  function buildSportsContext() {
    if (!sportsData?.teams) {
      return "\n\n[BAY AREA SPORTS]: No sports data currently available. Tell the user you don't have the latest scores.";
    }
    let context = '\n\n[BAY AREA SPORTS]:\n';
    for (const [key, team] of Object.entries(sportsData.teams)) {
      const t = team;
      context += `\n${t.name} (${t.sport}):\n`;
      if (t.record) context += `  Record: ${t.record.wins}-${t.record.losses}\n`;
      if (t.standings?.summary) context += `  Standing: ${t.standings.summary}\n`;
      if (t.standings?.divisionRank) context += `  Division Rank: #${t.standings.divisionRank}\n`;
      if (t.streak) context += `  Streak: ${t.streak}\n`;
      if (t.lastGame)
        context += `  Last Game: ${t.lastGame.result} vs ${t.lastGame.opponent} (${t.lastGame.date})\n`;
      if (t.nextGame)
        context += `  Next Game: ${t.nextGame.date} ${t.nextGame.time} vs ${t.nextGame.opponent} (${t.nextGame.home ? 'Home' : 'Away'})\n`;
      if (t.recentResults?.length > 0)
        context += `  Last ${t.recentResults.length} games: ${t.recentResults.join('')}\n`;
      if (t.isPlayoffs) context += `  IN PLAYOFFS!\n`;
      if (t.excitement) context += `  Excitement: ${t.excitement}\n`;
    }
    if (sportsData.todaysGames?.length > 0) {
      context += `\nToday's Games:\n`;
      for (const g of sportsData.todaysGames) {
        context += `  ${g.team}: vs ${g.opponent} at ${g.time} (${g.status}${g.score ? ` ${g.score.team}-${g.score.opponent}` : ''})\n`;
      }
    }
    context += `\nData updated: ${sportsData.generated}\n`;
    return context;
  }

  /**
   * Call 1 of two-call pattern: parse user intent via LLM.
   * Returns structured JSON with search query, category, flags.
   * Uses Ollama (fast, CPU) with minimal tokens.
   */
  async function parseIntent(message, history = []) {
    // Build minimal context — last 2 turns + current message
    const recentHistory = history.slice(-4);
    const messages = [
      { role: 'system', content: INTENT_PARSER_PROMPT },
      ...recentHistory,
      { role: 'user', content: message },
    ];

    try {
      // Use Ollama's OpenAI-compatible endpoint for intent parsing (structured JSON output)
      const intentEndpoint = isTorBrowser ? openaiTorEndpoint : openaiEndpoint;

      const resp = await fetch(intentEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: modelName,
          messages,
          stream: false,
          max_tokens: 250,
          temperature: 0.1, // Deterministic for structured output
          response_format: intentSchema, // Enforce JSON schema — guarantees valid output
        }),
        signal: AbortSignal.timeout(10000),
      });

      if (!resp.ok) throw new Error(`Intent parse failed: ${resp.status}`);
      const data = await resp.json();
      // OpenAI format: choices[0].message.content — now guaranteed valid JSON by schema
      const content = data.choices?.[0]?.message?.content || '';

      return JSON.parse(content);
    } catch (err) {
      console.warn('Intent parse failed, using fallback classification:', err.message);
      // Fallback: use existing classifyQueryType
      const queryType = classifyQueryType(message);
      // Map classifyQueryType results to intent parser categories
      const categoryRemap = {
        benefits: 'general',
        senior_benefits: 'seniors',
        veteran_benefits: 'veterans',
        disability_benefits: 'disability',
        immigrant_services: 'legal',
        community_resources: 'general',
        public_services: 'general',
        food_trucks: 'food',
        library: 'education',
        facilities: 'general',
        sports: 'sports', // Map sports queries to sports category
      };
      return {
        query: message,
        category: categoryRemap[queryType] || queryType,
        needs_location: [
          'benefits',
          'local_rules',
          'senior_benefits',
          'veteran_benefits',
          'disability_benefits',
          'immigrant_services',
          'public_services',
          'facilities',
        ].includes(queryType),
        needs_age: ['senior_benefits'].includes(queryType),
        is_followup: false,
        is_greeting: /^(hi|hello|hey|howdy|good morning|good afternoon)\b/i.test(message),
        is_crisis: queryType === 'crisis',
        data_sources: inferDataSourcesFromRegex(message, categoryRemap[queryType] || queryType),
      };
    }
  }

