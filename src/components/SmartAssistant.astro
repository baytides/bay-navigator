    // Common program name mappings (what users might say -> program keywords)
    const programAliases = {
      'food stamps': 'calfresh',
      snap: 'calfresh',
      ebt: 'calfresh',
      welfare: 'calworks',
      tanf: 'calworks',
      'free healthcare': 'medi-cal',
