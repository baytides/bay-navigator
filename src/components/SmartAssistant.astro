  /**
   * Search programs via Meilisearch (fast, typo-tolerant, server-side).
   * Falls back to the old client-side searchPrograms() if Meilisearch is unavailable.
   */
  async function searchViaTypesense(query, options = {}) {
    const { category, limit = 8 } = options;
    try {
      const body = {
        q: query,
        limit,
        attributesToSearchOn: ['name', 'keywords', 'description', 'area', 'city'],
        showRankingScore: true,
      };

      const filterParts = [];
      if (category && category !== 'general') {
        const categoryMap = {
          food: 'Food',
          health: 'Health',
          housing: 'Housing',
          legal: 'Legal',
          employment: 'Employment',
          education: 'Education',
          pets: 'Pet Resources',
          transit: 'Transportation',
        };
        // Demographic intents → groups filter (not category)
        const groupsMap = {
          seniors: 'seniors',
          veterans: 'veterans',
          disability: 'disabled',
        };
        const facetValue = categoryMap[category];
        const groupValue = groupsMap[category];
        if (facetValue) {
          filterParts.push(`category = "${facetValue}"`);
        } else if (groupValue) {
          filterParts.push(`groups IN ["${groupValue}"]`);
        }
      }
      if (filterParts.length > 0) {
        body.filter = filterParts.join(' AND ');
      }

      const resp = await fetch(`${MEILI_BASE_URL}/indexes/programs/search`, {
        method: 'POST',
        signal: AbortSignal.timeout(5000),
        headers: {
          Authorization: `Bearer ${MEILI_SEARCH_KEY}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(body),
      });
      if (!resp.ok) throw new Error(`Meilisearch ${resp.status}`);

      const data = await resp.json();
      return (data.hits || []).map((hit) => ({
        id: hit.id,
        name: hit.name,
        description: hit.description || '',
        category: hit.category || '',
        areas: hit.area ? [hit.area] : [],
        counties: hit.counties || [],
        city: hit.city || '',
        groups: hit.groups || [],
        phone: hit.phone || '',
        link: hit.link || '',
        website: hit.link || '',
        score: hit._rankingScore || 0,
      }));
    } catch (err) {
      console.warn('Meilisearch search failed, falling back to local:', err.message);
      return searchPrograms(query);
    }
  }

  /**
   * Web search fallback via SearXNG — used when Typesense has no results.
   * Returns formatted context string for LLM, or empty string on failure.
   */
  async function webSearchFallback(query) {
    try {
      const params = new URLSearchParams({
        q: `${query} Bay Area California`,
        format: 'json',
        categories: 'general',
      });
      const resp = await fetch(`${searchEndpoint}?${params}`, {
        signal: AbortSignal.timeout(5000),
      });
      if (!resp.ok) return '';
      const data = await resp.json();
      const results = (data.results || []).slice(0, 3);
      if (results.length === 0) return '';

      let context = '\n\n[WEB SEARCH RESULTS]\n';
      results.forEach((r, i) => {
        context += `${i + 1}. ${r.title}\n`;
        if (r.content) context += `   ${r.content.substring(0, 200)}\n`;
        if (r.url) context += `   Source: ${r.url}\n`;
      });
      context += '\nUse these web results to help answer. Cite sources when possible.';
      console.log(`[Carl] Web search fallback: ${results.length} results for "${query}"`);
      return context;
    } catch (err) {
      console.log('[Carl] Web search fallback failed:', err.message);
      return '';
    }
  }

  // Fetch municipal code context (ordinances + deep content + California state law)
  async function fetchMunicipalContext(searchQuery, message, userLocation) {
    let context = '';
    const lookupQuery = searchQuery.length > 3 ? searchQuery : message;
    const recentUserMsgs = conversationHistory
      .filter((m) => m.role === 'user')
      .slice(-3)
      .map((m) => m.content)
      .join(' ');
    const fullQueryContext = `${lookupQuery} ${recentUserMsgs}`;

    const cityName = userLocation?.city || null;
    const municipalResult = await searchMunicipalCode(fullQueryContext, userLocation);
    if (municipalResult) {
      const deepResult = await searchMunicipalDeepContent(
        municipalResult.name,
        municipalResult.topics
      );

      if (deepResult?.sections?.length > 0) {
        context += formatMunicipalDeepContentForContext(deepResult);
        context += `\nGeneral municipal code: ${municipalResult.codeUrl}`;
      } else {
        context += '\n\n[MUNICIPAL CODE]:\n';
        context += `City: ${municipalResult.name} (${municipalResult.county} County)\n`;
        context += `Municipal Code URL: ${municipalResult.codeUrl}\n`;
        if (municipalResult.topics) {
          context += `Relevant sections to look up: ${municipalResult.topics.join(', ')}\n`;
        }
        context += `\nYou MUST include the URL ${municipalResult.codeUrl} in your response as a clickable link. Say something like "You can look up [topic] in ${municipalResult.name}'s municipal code: ${municipalResult.codeUrl}". Do NOT guess the actual rule — just point them to the code.`;
      }
    } else if (cityName) {
      context += `\n\n[MUNICIPAL CODE]: No municipal code found for ${cityName}. Suggest the user call their city hall or check their city's website for local ordinances.`;
    }
    return context;
  }

