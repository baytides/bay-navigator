  .crisis-banner-icon {
    @apply flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center;
  }

  .crisis-banner.emergency .crisis-banner-icon {
    @apply bg-red-500 text-white;
  }

  .crisis-banner.mental-health .crisis-banner-icon {
