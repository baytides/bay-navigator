    const queryLower = query.toLowerCase();
    const terms = queryLower.split(/\s+/).filter((t) => t.length >= 2);
    const expanded = new Set<string>([queryLower]);

    // First, check for multi-word phrase matches (more specific, higher priority)
    // Only match phrases that are complete word boundaries
    for (const [phrase, synonyms] of Object.entries(SYNONYMS)) {
      // Check if phrase exists as complete words (not substring)
      const phraseRegex = new RegExp(`\\b${phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'i');
      if (phraseRegex.test(queryLower)) {
        // Add only the most relevant synonyms (limit to 3 to reduce noise)
        synonyms.slice(0, 3).forEach((syn) => expanded.add(syn));
      }
    }

    // Then check individual terms, but only if we didn't already match a phrase containing them
    for (const term of terms) {
      // Skip very common words that would add too much noise
      const stopWords = ['help', 'need', 'get', 'find', 'how', 'can', 'the', 'for', 'and', 'with'];
      if (stopWords.includes(term)) continue;

      if (SYNONYMS[term]) {
        // Add limited synonyms to avoid search explosion
        SYNONYMS[term].slice(0, 3).forEach((syn) => expanded.add(syn));
      }
    }

    return Array.from(expanded);
  }

  // Rewrite natural language queries - augment instead of replace
  function rewriteQuery(query: string): string {
    const queryLower = query.toLowerCase().trim();

    // Check for exact rewrites first
    if (QUERY_REWRITES[queryLower]) {
      return QUERY_REWRITES[queryLower];
    }

    // For partial matches, augment the query instead of replacing it entirely
    // This preserves user context while adding relevant terms
    for (const [pattern, rewrite] of Object.entries(QUERY_REWRITES)) {
      // Only match at word boundaries to avoid false substring matches
      const patternRegex = new RegExp(
        `\\b${pattern.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`,
        'i'
      );
      if (patternRegex.test(queryLower)) {
        // If the rewrite is different and adds value, combine them
        if (rewrite.toLowerCase() !== queryLower && !queryLower.includes(rewrite.toLowerCase())) {
          return `${query} ${rewrite}`;
        }
        return rewrite;
      }
    }

    return query;
  }

  // Get best bets for a query
  function getBestBets(query: string): string[] {
    const queryLower = query.toLowerCase().trim();
    const terms = queryLower.split(/\s+/);

    // Check for exact match first
    if (BEST_BETS[queryLower]) {
      return BEST_BETS[queryLower];
    }

    // Check individual terms
    for (const term of terms) {
      if (BEST_BETS[term]) {
        return BEST_BETS[term];
      }
    }

    return [];
  }

  // Show type-ahead suggestions
  function showTypeahead(query: string) {
    if (!typeaheadDropdown || !typeaheadList || query.length < 2) {
      hideTypeahead();
      return;
    }

    const queryLower = query.toLowerCase();
    const matches = SUGGESTIONS.filter((s) => s.toLowerCase().includes(queryLower)).slice(0, 6);

    if (matches.length === 0) {
      hideTypeahead();
      return;
    }

    typeaheadList.innerHTML = matches
      .map(
        (suggestion, i) => `
      <li role="option"
          class="typeahead-item ${i === selectedSuggestionIndex ? 'selected' : ''}"
          data-suggestion="${suggestion}">
        <svg class="w-4 h-4 text-neutral-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <span>${highlightMatch(suggestion, query)}</span>
      </li>
    `
      )
      .join('');

    typeaheadDropdown.classList.remove('hidden');

    // Add click handlers
    typeaheadList.querySelectorAll('.typeahead-item').forEach((item) => {
      item.addEventListener('click', () => {
        const suggestion = (item as HTMLElement).dataset.suggestion;
        if (suggestion && searchInput) {
          (searchInput as HTMLInputElement).value = suggestion;
          hideTypeahead();
          void performSearch();
        }
      });
    });
  }

  function hideTypeahead() {
    typeaheadDropdown?.classList.add('hidden');
    selectedSuggestionIndex = -1;
  }

  function highlightMatch(text: string, query: string): string {
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return text.replace(regex, '<strong>$1</strong>');
  }

  // Handle keyboard navigation for type-ahead
  function handleTypeaheadKeydown(e: KeyboardEvent) {
    const items = typeaheadList?.querySelectorAll('.typeahead-item') || [];
    if (items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedSuggestionIndex = Math.min(selectedSuggestionIndex + 1, items.length - 1);
      updateTypeaheadSelection(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedSuggestionIndex = Math.max(selectedSuggestionIndex - 1, -1);
      updateTypeaheadSelection(items);
    } else if (e.key === 'Tab' && selectedSuggestionIndex >= 0) {
      e.preventDefault();
      const selected = items[selectedSuggestionIndex] as HTMLElement;
      const suggestion = selected?.dataset?.suggestion;
      if (suggestion && searchInput) {
        (searchInput as HTMLInputElement).value = suggestion;
        hideTypeahead();
      }
    } else if (e.key === 'Escape') {
      hideTypeahead();
    }
  }

  function updateTypeaheadSelection(items: NodeListOf<Element>) {
    items.forEach((item, i) => {
      if (i === selectedSuggestionIndex) {
        item.classList.add('selected');
      } else {
        item.classList.remove('selected');
      }
    });
  }

  // Build search index from program cards on directory page
  const cards = document.querySelectorAll('[data-category]');

  const programs = Array.from(cards).map((card, index) => {
    const id = card.getAttribute('data-program-id') || card.id?.replace('program-', '') || '';
    const groups = (card.getAttribute('data-groups') || '')
      .split(',')
      .map((group) => group.trim())
      .filter(Boolean);

    return {
      index,
      element: card,
      id,
      category: card.getAttribute('data-category') || '',
      area: card.getAttribute('data-area') || '',
      groups,
      verified: card.getAttribute('data-verified') === 'true',
    };
  });

  const programById = new Map(programs.map((program) => [program.id, program]));
  const originalOrder = programs.map((program) => program.element);
  const resultsContainer = document.getElementById('programs-grid');

  const SEARCH_INDEX_URL = '/api/search-index.json';

  // Shared Meilisearch config — single source of truth for all search surfaces
  import { searchMeilisearch as sharedSearchMeilisearch } from '@/lib/search';
  import { MEILISEARCH_CONFIG, FUSE_SEARCH_KEYS, FUSE_OPTIONS } from '@/lib/search-config';
  import { resolveLocationInput, buildCountiesFilter } from '@/lib/location';

  const MEILI_BASE_URL = import.meta.env.DEV
    ? MEILISEARCH_CONFIG.devBaseUrl
    : MEILISEARCH_CONFIG.baseUrl;

  // Detect if accessing via Tor (.onion) - Meilisearch won't work over Tor, use Fuse.js fallback
  const isOnionSite = typeof window !== 'undefined' && window.location.hostname.endsWith('.onion');

  // Feature flag for Meilisearch - disabled for Tor users, enabled for all others
  const USE_MEILISEARCH = !isOnionSite;

  // Fuse.js weights and options from shared config (single source of truth)
  const DEFAULT_SEARCH_KEYS = [...FUSE_SEARCH_KEYS];
  const DEFAULT_FUSE_OPTIONS = { ...FUSE_OPTIONS };

  let searchDocuments = [];
  let searchDocumentsById = new Map();
  let fuse = null;

  function buildSearchDocumentsFromDom() {
    const documents = programs.map((program) => {
      const nameEl = program.element.querySelector('[data-program-name]');
      const descEl = program.element.querySelector('p');
      const areaEl = program.element.querySelector(
        '[class*="text-neutral-700"], [class*="text-neutral-600"]'
      );
      const keywords = program.element.getAttribute('data-keywords') || '';
      const city = program.element.getAttribute('data-city') || '';

      return {
        id: program.id,
        name: nameEl?.textContent?.trim() || '',
        description: descEl?.textContent?.trim() || '',
        category: program.category || '',
        area: areaEl?.textContent?.trim() || '',
        keywords,
        city,
      };
    });

    searchDocuments = documents;
    searchDocumentsById = new Map(documents.map((doc) => [doc.id, doc]));
    fuse = new Fuse(searchDocuments, DEFAULT_FUSE_OPTIONS);
  }

  async function loadSearchIndex() {
    try {
      const response = await fetch(SEARCH_INDEX_URL, { cache: 'force-cache' });
      if (!response.ok) {
        throw new Error(`Search index request failed: ${response.status}`);
      }

      const data = await response.json();
      if (!Array.isArray(data?.documents)) {
        throw new Error('Search index payload missing documents');
      }

      const keys = data?.keys || DEFAULT_SEARCH_KEYS;
      const index =
        data?.index && typeof Fuse.parseIndex === 'function' ? Fuse.parseIndex(data.index) : null;

      searchDocuments = data.documents;
      searchDocumentsById = new Map(searchDocuments.map((doc) => [doc.id, doc]));
      fuse = index
        ? new Fuse(searchDocuments, { ...DEFAULT_FUSE_OPTIONS, keys }, index)
        : new Fuse(searchDocuments, { ...DEFAULT_FUSE_OPTIONS, keys });
    } catch (error) {
      console.warn('Search index unavailable, falling back to DOM search.', error);
      buildSearchDocumentsFromDom();
    }
  }

  const searchIndexReady = loadSearchIndex();

  const searchInput = document.getElementById('search-input');
  const searchHints = document.getElementById('search-hints');
  const hintButtons = document.querySelectorAll('.search-hint-btn');
  const inlineClearBtn = document.getElementById('search-clear-btn');
  const searchSubmitBtn = document.getElementById('search-submit-btn');

  // Aria-live announcers for screen readers
  const searchAnnouncer = document.getElementById('search-announcer');
  const urgentAnnouncer = document.getElementById('search-urgent-announcer');

  // Announce search results to screen readers
  function announceToScreenReader(message: string, urgent = false) {
    const announcer = urgent ? urgentAnnouncer : searchAnnouncer;
    if (announcer) {
      // Clear and re-set to ensure announcement
      announcer.textContent = '';
      setTimeout(() => {
        announcer.textContent = message;
      }, 100);
    }
  }

  let activeCategory = 'all';

  function updateInputState() {
    if (!searchInput) return;
    const hasValue = searchInput.value.trim().length > 0;
    inlineClearBtn?.classList.toggle('hidden', !hasValue);
    searchHints?.classList.toggle('hidden', hasValue);
  }

  updateInputState();

  async function ensureFuseReady() {
    if (fuse) return;
    await searchIndexReady;
    if (!fuse) {
      buildSearchDocumentsFromDom();
    }
  }

  /**
   * Search using shared Meilisearch module (unified searchable attributes + weights).
   * Returns array of program IDs sorted by relevance.
   */
  async function searchWithMeilisearch(
    query: string,
    filters?: { category?: string; area?: string }
  ): Promise<string[]> {
    try {
      // Yelp-like location filtering: when user has a location set,
      // filter to programs serving their county + regional/statewide programs
      let countiesFilter: string[] | undefined;
      if (currentLocation?.county) {
        const resolved = resolveLocationInput(
          currentLocation.city || currentLocation.county,
          ZIP_TO_CITY,
          CITY_TO_COUNTY
        );
        if (resolved) {
          countiesFilter = buildCountiesFilter(resolved.countySlug);
        }
      }

      const results = await sharedSearchMeilisearch(query, {
        limit: 50,
        counties: countiesFilter,
        category: filters?.category && filters.category !== 'all' ? filters.category : undefined,
        baseUrl: MEILI_BASE_URL,
      });

      return results.map((r) => r.id);
    } catch (error) {
      console.warn('Meilisearch search failed, falling back to Fuse.js:', error);
      return []; // Empty array signals fallback to Fuse.js
    }
  }

  function getActiveFilters() {
    const categorySelect = document.getElementById('category-select') as HTMLSelectElement | null;
    const verifiedCheckbox = document.getElementById('verified-only') as HTMLInputElement | null;
    const activeGroupBtn = document.querySelector('.group-filter-btn[data-active="true"]');
    const categoryValue = categorySelect?.value || activeCategory || 'all';

    return {
      category: categoryValue.toLowerCase(),
      group: activeGroupBtn?.getAttribute('data-group') || null,
      verifiedOnly: verifiedCheckbox?.checked || false,
    };
  }

  function matchesActiveFilters(program) {
    const filters = getActiveFilters();
    const programCategory = program.category || '';
    const matchesCategory =
      filters.category === 'all' || programCategory.toLowerCase() === filters.category;
    const matchesGroup = !filters.group || program.groups.includes(filters.group);
    const matchesVerified = !filters.verifiedOnly || program.verified;
    const locationHidden = program.element.hasAttribute('data-location-hidden');

    return matchesCategory && matchesGroup && matchesVerified && !locationHidden;
  }

  function getProgramName(id: string) {
    const docName = searchDocumentsById.get(id)?.name;
    if (docName) return docName;

    const program = programById.get(id);
    const nameEl = program?.element.querySelector('[data-program-name]');
    return nameEl?.textContent?.trim() || '';
  }

  function shouldApplyRelevanceOrder() {
    const relevanceBtn = document.getElementById('sort-relevance');
    const alphaBtn = document.getElementById('sort-alpha');
    if (!relevanceBtn || !alphaBtn) {
      return true;
    }

    return relevanceBtn.getAttribute('aria-checked') === 'true';
  }

  function applyRelevanceOrder(rankedIds: string[]) {
    if (!shouldApplyRelevanceOrder()) return;
    if (!resultsContainer) return;
    const rankedSet = new Set(rankedIds);
    const orderedPrograms = [
      ...rankedIds.map((id) => programById.get(id)).filter((program) => program),
      ...programs.filter((program) => !rankedSet.has(program.id)),
    ];

    orderedPrograms.forEach((program) => {
      const node = program.element;
      if (node && resultsContainer.contains(node)) {
        resultsContainer.appendChild(node);
      }
    });
  }

  function resetRelevanceOrder() {
    if (!shouldApplyRelevanceOrder()) return;
    if (!resultsContainer) return;
    originalOrder.forEach((node) => {
      if (resultsContainer.contains(node)) {
        resultsContainer.appendChild(node);
      }
    });
  }

  function setRelevanceRanks(rankedIds: string[]) {
    const rankById = new Map(rankedIds.map((id, index) => [id, index]));
    programs.forEach((program) => {
      const rank = rankById.get(program.id);
      if (rank === undefined) {
        program.element.removeAttribute('data-relevance-rank');
        return;
      }
      program.element.setAttribute('data-relevance-rank', String(rank));
    });
  }

  // Category name mappings for category-based search matching
  // Maps search terms to actual category values in the data
  const CATEGORY_MAPPINGS: Record<string, { categories: string[]; boostKeywords: string[] }> = {
    food: {
      categories: ['Food'],
      boostKeywords: [
        'calfresh',
        'food bank',
        'pantry',
        'snap',
        'wic',
        'meals',
        'groceries',
        'hungry',
      ],
    },
    housing: {
      categories: ['Housing'],
      boostKeywords: ['shelter', 'rent', 'section 8', 'homeless', 'housing', 'eviction'],
    },
    health: {
      categories: ['Health'],
      boostKeywords: ['medi-cal', 'clinic', 'medical', 'doctor', 'healthcare'],
    },
    healthcare: {
      categories: ['Health'],
      boostKeywords: ['medi-cal', 'clinic', 'medical', 'doctor', 'healthcare'],
    },
    medical: {
      categories: ['Health'],
      boostKeywords: ['medi-cal', 'clinic', 'doctor', 'hospital'],
    },
    jobs: {
      categories: ['Employment'],
      boostKeywords: ['employment', 'job', 'career', 'workforce', 'hiring'],
    },
    employment: {
      categories: ['Employment'],
      boostKeywords: ['job', 'career', 'workforce', 'hiring', 'work'],
    },
    legal: {
      categories: ['Legal Services'],
      boostKeywords: ['lawyer', 'attorney', 'legal aid', 'court'],
    },
    utilities: {
      categories: ['Utilities'],
      boostKeywords: ['pge', 'care program', 'liheap', 'energy', 'electric', 'gas'],
    },
  };

  // Maximum category-boosted results to prevent overwhelming results
  const MAX_CATEGORY_RESULTS = 25;

  // Cache for Meilisearch results (cleared on each search)
  let meilisearchResultsCache: string[] | null = null;

  /**
   * Try to get results from Meilisearch first.
   * Returns null if Meilisearch unavailable or disabled.
   */
  async function tryMeilisearchSearch(
    query: string
  ): Promise<Map<string, { id: string; score: number }> | null> {
    if (!USE_MEILISEARCH) return null;

    try {
      const filters = getActiveFilters();
      const ids = await searchWithMeilisearch(query, { category: filters.category });

      if (ids.length === 0) return null; // Fall back to Fuse.js

      // Convert to Map format matching collectSearchResults output
      const resultsById = new Map<string, { id: string; score: number }>();
      ids.forEach((id, index) => {
        const program = programById.get(id);
        if (program && matchesActiveFilters(program)) {
          // Meilisearch returns results in relevance order, so use index as score (lower = better)
          resultsById.set(id, { id, score: index * 0.01 });
        }
      });

      return resultsById.size > 0 ? resultsById : null;
    } catch (error) {
      console.warn('Meilisearch search failed:', error);
      return null;
    }
  }

  function collectSearchResults(terms: string[]) {
    const resultsById = new Map();

    // First, do fuzzy search for all terms (primary results)
    terms.forEach((term) => {
      const results = fuse.search(term);
      results.forEach((result) => {
        const id = result.item.id;
        const program = programById.get(id);
        if (!program || !matchesActiveFilters(program)) return;

        const score = result.score ?? 1;
        const existing = resultsById.get(id);
        if (!existing || score < existing.score) {
          resultsById.set(id, { id, score });
        }
      });
    });

    // Then, if we have very few results AND the query matches a category,
    // add top programs from that category (tiered boost based on relevance)
    terms.forEach((term) => {
      const termLower = term.toLowerCase();
      const mapping = CATEGORY_MAPPINGS[termLower];

      // Only boost if we have less than 10 fuzzy results
      if (mapping && resultsById.size < 10) {
        const categoryPrograms: Array<{ program: (typeof programs)[0]; relevanceScore: number }> =
          [];

        programs.forEach((program) => {
          if (!matchesActiveFilters(program)) return;
          // Skip if already in results
          if (resultsById.has(program.id)) return;

          const programCategory = program.category || '';
          if (
            !mapping.categories.some((cat) => programCategory.toLowerCase() === cat.toLowerCase())
          ) {
            return;
          }

          // Calculate relevance score based on boost keywords in name/description
          const name = (program.name || '').toLowerCase();
          const desc = (program.description || '').toLowerCase();
          const keywords = (program.keywords || []).join(' ').toLowerCase();

          let relevanceScore = 0.5; // Base score for category match (worse than fuzzy match)

          // Boost based on matching keywords
          mapping.boostKeywords.forEach((kw) => {
            if (name.includes(kw))
              relevanceScore -= 0.15; // Strong boost for name match
            else if (keywords.includes(kw)) relevanceScore -= 0.08;
            else if (desc.includes(kw)) relevanceScore -= 0.03;
          });

          // Ensure score stays in valid range (0-1, lower is better)
          relevanceScore = Math.max(0.1, Math.min(0.9, relevanceScore));

          categoryPrograms.push({ program, relevanceScore });
        });

        // Sort by relevance and take top N
        categoryPrograms
          .sort((a, b) => a.relevanceScore - b.relevanceScore)
          .slice(0, MAX_CATEGORY_RESULTS)
          .forEach(({ program, relevanceScore }) => {
            resultsById.set(program.id, { id: program.id, score: relevanceScore });
          });
      }
    });

    return resultsById;
  }

  // Check if a program's area matches user's location (for boosting relevance)
  function getLocationBoost(programId: string): number {
    if (!currentLocation?.county) return 0;

    const program = programById.get(programId);
    if (!program) return 0;

    const area = (program.area || '').toLowerCase();
    const userCounty = currentLocation.county.toLowerCase();
    const userCity = (currentLocation.city || '').toLowerCase();

    // Exact city match: strongest boost
    if (userCity && area.includes(userCity)) {
      return -0.15; // Negative = better (lower Fuse score = better match)
    }

    // County match: strong boost
    if (area.includes(userCounty)) {
      return -0.1;
    }

    // Bay Area / regional programs: slight boost (still relevant)
    if (area.includes('bay area') || area.includes('statewide') || area.includes('california')) {
      return -0.02;
    }

    return 0;
  }

  function rankSearchResults(resultsById: Map<string, { id: string; score: number }>, bestBetIds) {
    const bestBetRank = new Map();
    bestBetIds.forEach((id, index) => {
      bestBetRank.set(id, index);
    });

    const bestBets = bestBetIds
      .map((id) => {
        const program = programById.get(id);
        if (!program || !matchesActiveFilters(program)) return null;
        return { id, score: -1, bestBetRank: bestBetRank.get(id) ?? 0 };
      })
      .filter(Boolean);

    const regularResults = Array.from(resultsById.values()).filter(
      (result) => !bestBetRank.has(result.id)
    );

    // Apply location boost to scores
    regularResults.forEach((result) => {
      result.score += getLocationBoost(result.id);
    });

    regularResults.sort((a, b) => {
      if (a.score !== b.score) {
        return a.score - b.score;
      }

      const nameA = getProgramName(a.id).toLowerCase();
      const nameB = getProgramName(b.id).toLowerCase();
      if (nameA !== nameB) {
        return nameA.localeCompare(nameB);
      }

      return a.id.localeCompare(b.id);
    });

    const rankedResults = [
      ...bestBets.sort((a, b) => a.bestBetRank - b.bestBetRank),
      ...regularResults,
    ];

    return rankedResults.map((result) => result.id);
  }

  // Track active category filter
  document.addEventListener('click', (e) => {
    const filterBtn = e.target.closest('[data-filter]');
    if (filterBtn) {
      activeCategory = filterBtn.getAttribute('data-filter') || 'all';
      void performSearch();
    }
  });

  async function performFuzzySearch(query) {
    await ensureFuseReady();

    if (!query) {
      // No search query - show all (respect category filter)
      programs.forEach((p) => {
        const shouldShow = matchesActiveFilters(p);
        p.element.style.display = shouldShow ? '' : 'none';
        p.element.classList.remove('best-bet');
        p.element.removeAttribute('data-relevance-rank');
      });
      resetRelevanceOrder();
    } else {
      // Apply search enhancements
      const rewrittenQuery = rewriteQuery(query);
      const bestBetIds = new Set(getBestBets(query));

      // Try Meilisearch first (typo-tolerant), fall back to Fuse.js
      let resultsById = await tryMeilisearchSearch(rewrittenQuery);
      if (!resultsById) {
        // Meilisearch unavailable or returned no results - use Fuse.js
        const expandedTerms = expandWithSynonyms(rewrittenQuery);
        resultsById = collectSearchResults(expandedTerms);
      }

      const rankedIds = rankSearchResults(resultsById, Array.from(bestBetIds));
      const matchedIds = new Set(rankedIds);
      setRelevanceRanks(rankedIds);
      applyRelevanceOrder(rankedIds);

      programs.forEach((p) => {
        const matchesSearch = matchedIds.has(p.id);
        const isBestBet = bestBetIds.has(p.id);
        const shouldShow = matchesSearch;

        p.element.style.display = shouldShow ? '' : 'none';

        // Mark best bets for styling
        if (isBestBet && shouldShow) {
          p.element.classList.add('best-bet');
        } else {
          p.element.classList.remove('best-bet');
        }
      });
    }

    // Update count
    const visibleCount = document.querySelectorAll(
      '[data-category]:not([style*="display: none"])'
    ).length;
    updateResultsCount(visibleCount, query);

    // Announce results to screen readers
    if (query) {
      if (visibleCount === 0) {
        announceToScreenReader(`No programs found for "${query}". Try different search terms.`);
      } else {
        announceToScreenReader(
          `Found ${visibleCount} program${visibleCount !== 1 ? 's' : ''} for "${query}"`
        );
      }
    }

    // Check if refinement bar should be shown
    checkAndShowRefinement(query, visibleCount);
  }

  function updateResultsCount(count, query) {
    const counter = document.getElementById('results-count');
    if (counter) {
      const queryInfo = query ? ` for "${query}"` : '';
      counter.textContent = `${count} program${count !== 1 ? 's' : ''} found${queryInfo}`;
    }
  }

  // Crisis detection - show appropriate help resources
  // Only triggers on ACTIVE DANGER keywords, not general help-seeking queries
  function checkForCrisis(query) {
    const lowerQuery = query.toLowerCase();

    // Context words that indicate clearly academic/professional queries
    // where the crisis banner would be noise rather than helpful
    // Since our search shows program cards + banner (additive), we're generous
    // with showing the banner - it has a close button if not needed
    const academicProfessionalContext = [
      'statistics',
