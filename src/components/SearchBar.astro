---
import yaml from 'js-yaml';
import fs from 'fs';
import path from 'path';

interface Props {
  placeholder?: string;
}

const { placeholder = 'Search programs...' } = Astro.props;

// Load search configuration at build time
let searchConfig = { synonyms: {}, best_bets: {}, suggestions: [], query_rewrites: {} };
try {
  const configPath = path.join(process.cwd(), 'src/data/search-config.yml');
  const configContent = fs.readFileSync(configPath, 'utf8');
  searchConfig = yaml.load(configContent) as typeof searchConfig;
} catch (e) {
  console.warn('Could not load search-config.yml:', e);
}

// Load location lookup data at build time (cities.yml + zipcodes.yml)
// These are serialized to data attributes so the client can resolve ZIP/city → county
let zipToCityMap: Record<string, string> = {};
let cityToCountyMap: Record<string, string> = {};
try {
  const citiesPath = path.join(process.cwd(), 'src/data/cities.yml');
  const citiesData = yaml.load(fs.readFileSync(citiesPath, 'utf8')) as Array<{
    name: string;
    county: string;
  }>;
  for (const city of citiesData) {
    cityToCountyMap[city.name.toLowerCase()] = city.county;
  }

  const zipPath = path.join(process.cwd(), 'src/data/zipcodes.yml');
  const zipData = yaml.load(fs.readFileSync(zipPath, 'utf8')) as Record<string, string>;
  zipToCityMap = Object.fromEntries(
    Object.entries(zipData).map(([zip, city]) => [String(zip), city])
  );
} catch (e) {
  console.warn('Could not load location data:', e);
}
---

<div class="search-container">
  <div class="search-shell search-bar">
    <!-- Search field -->
    <div class="search-bar-field relative">
      <span class="search-bar-field-label">What</span>
      <label for="search-input" class="sr-only" data-i18n="common.search">Search programs</label>
      <svg
        class="search-bar-field-icon"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        type="search"
        id="search-input"
        class="search-bar-input"
        placeholder={placeholder}
        autocomplete="off"
      />
      <button
        type="button"
        id="search-clear-btn"
        class="hidden flex-shrink-0 rounded p-1 text-neutral-500 hover:text-neutral-700 dark:text-neutral-300 dark:hover:text-neutral-200 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500"
        aria-label="Clear search"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Type-ahead dropdown -->
      <div id="typeahead-dropdown" class="typeahead-dropdown hidden">
        <ul id="typeahead-list" role="listbox" aria-label="Search suggestions"></ul>
      </div>
    </div>

    <!-- Dividers -->
    <div class="search-bar-divider" aria-hidden="true"></div>
    <div class="search-bar-divider-mobile" aria-hidden="true"></div>

    <!-- Location field -->
    <div class="search-bar-field sm:max-w-[14rem]">
      <span class="search-bar-field-label">Where</span>
      <svg
        class="search-bar-field-icon"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
        ></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <label for="location-input" class="sr-only">City or ZIP code</label>
      <input
        id="location-input"
        type="text"
        class="search-bar-input text-sm"
        placeholder="City or ZIP"
        autocomplete="postal-code"
        aria-label="City or ZIP code"
      />
    </div>

    <!-- Submit -->
    <button
      type="button"
      id="search-submit-btn"
      class="search-bar-cta"
      aria-label="Search programs"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <span class="hidden sm:inline" data-i18n="common.search">Search</span>
    </button>
  </div>

  <!-- Hint pills (below bar) -->
  <div id="search-hints" class="search-hints mt-3">
    <span class="search-hints-label">Try:</span>
    <div class="search-hints-list">
      <button type="button" class="search-hint-btn" data-type="keyword">Food assistance</button>
      <button type="button" class="search-hint-btn" data-type="keyword">Housing support</button>
      <button type="button" class="search-hint-btn" data-type="keyword">Utility help</button>
      <button type="button" class="search-hint-btn" data-type="keyword">Health clinics</button>
      <button type="button" class="search-hint-btn" data-type="keyword">Job training</button>
    </div>
  </div>

  <!-- Hidden element for JS compatibility with location quick button text -->
  <span id="location-quick-text" class="hidden">Set location</span>
</div>

<!-- Store API endpoint and search config in data attributes -->
<div
  id="search-config"
  data-synonyms={JSON.stringify(searchConfig.synonyms || {})}
  data-best-bets={JSON.stringify(searchConfig.best_bets || {})}
  data-suggestions={JSON.stringify(searchConfig.suggestions || [])}
  data-query-rewrites={JSON.stringify(searchConfig.query_rewrites || {})}
  data-zip-to-city={JSON.stringify(zipToCityMap)}
  data-city-to-county={JSON.stringify(cityToCountyMap)}
  class="hidden"
>
</div>

<!-- Screen reader announcements (aria-live regions) -->
<div class="sr-only" aria-live="polite" aria-atomic="true" id="search-announcer"></div>
<div class="sr-only" aria-live="assertive" aria-atomic="true" id="search-urgent-announcer"></div>

<!-- Refinement Bar (shown when results are broad) -->
<div
  id="refinement-bar"
  class="hidden mt-4 p-4 bg-neutral-50 dark:bg-neutral-800 rounded-lg border border-neutral-200 dark:border-neutral-700"
  role="region"
  aria-label="Search refinement options"
>
  <!-- Location display/prompt -->
  <div id="location-section" class="mb-4">
    <!-- Shown when location is set -->
    <div id="location-display" class="hidden flex items-center gap-2 text-sm flex-wrap">
      <svg
        class="w-4 h-4 text-neutral-700 dark:text-neutral-300 flex-shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
        ></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <span class="text-neutral-700 dark:text-neutral-300">Location:</span>
      <span id="location-value" class="font-medium text-neutral-900 dark:text-white"></span>
      <span id="location-source" class="text-xs text-neutral-700"></span>
      <button
        id="change-location-btn"
        type="button"
        class="text-primary-700 dark:text-primary-400 hover:underline text-sm focus:outline-hidden focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-neutral-800 rounded"
      >
        Change
      </button>
    </div>

    <!-- Shown when no location is set -->
    <div id="location-prompt" class="hidden">
      <p
        class="text-sm text-neutral-700 dark:text-neutral-300 mb-2 font-medium"
        id="location-prompt-label"
      >
        Where are you located?
      </p>
      <div
        class="flex items-center gap-2 flex-wrap"
        role="group"
        aria-labelledby="location-prompt-label"
      >
        <button
          id="use-gps-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-md bg-white dark:bg-neutral-900 border border-neutral-400 dark:border-neutral-600 text-neutral-700 dark:text-neutral-200 hover:bg-neutral-50 dark:hover:bg-neutral-800 focus:outline-hidden focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-neutral-800 transition-colors"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          Use my location
        </button>
        <span class="text-neutral-700 text-sm" aria-hidden="true">or</span>
        <label for="zip-city-input" class="sr-only">Enter ZIP code or city</label>
        <div class="flex items-center gap-1">
          <input
            type="text"
            id="zip-city-input"
            placeholder="ZIP code or city"
            class="px-3 py-1.5 text-sm rounded-md border border-neutral-400 dark:border-neutral-600 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white w-40 focus:outline-hidden focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
            autocomplete="postal-code"
          />
          <button
            id="submit-location-btn"
            type="button"
            class="px-3 py-1.5 text-sm font-medium rounded-md bg-primary-600 text-white hover:bg-primary-700 focus:outline-hidden focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-neutral-800 transition-colors"
            aria-label="Set location"
          >
            Go
          </button>
        </div>
      </div>
      <p class="text-xs text-neutral-700 dark:text-neutral-300 mt-2 flex items-center gap-1">
        <svg
          class="w-3 h-3 flex-shrink-0"
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
            clip-rule="evenodd"></path>
        </svg>
        Your location stays on your device
      </p>
    </div>
  </div>

  <!-- Category buttons -->
  <div id="category-refinement" role="group" aria-labelledby="category-prompt">
    <p id="category-prompt" class="text-sm text-neutral-700 dark:text-neutral-300 mb-3 font-medium">
      What kind of help are you looking for?
    </p>
    <div class="flex flex-wrap gap-2" id="category-buttons" role="list">
      <!-- Populated by JavaScript -->
    </div>
  </div>

  <!-- Sub-options (shown after category selection) -->
  <div id="suboption-refinement" class="hidden" role="group" aria-labelledby="suboption-prompt">
    <p
      id="suboption-prompt"
      class="text-sm text-neutral-700 dark:text-neutral-300 mb-3 font-medium"
    >
    </p>
    <div class="flex flex-wrap gap-2" id="suboption-buttons" role="list">
      <!-- Populated by JavaScript -->
    </div>
    <button
      id="back-to-categories"
      type="button"
      class="mt-3 text-sm text-primary-700 dark:text-primary-400 hover:underline flex items-center gap-1 focus:outline-hidden focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-neutral-800 rounded"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
        ></path>
      </svg>
      Back to all categories
    </button>
  </div>
</div>

<script is:inline src="/assets/js/search-crisis.js"></script>
<script is:inline src="/assets/js/search-engine.js"></script>
<script is:inline src="/assets/js/search-refinement.js"></script>

<script>
  import Fuse from 'fuse.js';

  // Load config
  const configEl = document.getElementById('search-config');

  // Load search enhancements from build-time config
  const SYNONYMS: Record<string, string[]> = JSON.parse(configEl?.dataset?.synonyms || '{}');
  const BEST_BETS: Record<string, string[]> = JSON.parse(configEl?.dataset?.bestBets || '{}');
  const SUGGESTIONS: string[] = JSON.parse(configEl?.dataset?.suggestions || '[]');
  const QUERY_REWRITES: Record<string, string> = JSON.parse(
    configEl?.dataset?.queryRewrites || '{}'
  );

  // Location lookup data (from cities.yml + zipcodes.yml at build time)
  const ZIP_TO_CITY: Record<string, string> = JSON.parse(configEl?.dataset?.zipToCity || '{}');
  const CITY_TO_COUNTY_YAML: Record<string, string> = JSON.parse(
    configEl?.dataset?.cityToCounty || '{}'
  );

  // City to county mapping — sourced from cities.yml via data attribute (complete Bay Area coverage)
  const CITY_TO_COUNTY: Record<string, string> = CITY_TO_COUNTY_YAML;

  // County coordinates for GPS lookup
  const COUNTY_COORDINATES: Record<string, { lat: number; lng: number }> = {
    'Alameda County': { lat: 37.6017, lng: -121.7195 },
    'Contra Costa County': { lat: 37.9193, lng: -121.9277 },
    'Marin County': { lat: 38.0834, lng: -122.7633 },
    'Napa County': { lat: 38.5025, lng: -122.2654 },
    'San Francisco': { lat: 37.7749, lng: -122.4194 },
    'San Mateo County': { lat: 37.4969, lng: -122.3331 },
    'Santa Clara County': { lat: 37.3541, lng: -121.9552 },
    'Solano County': { lat: 38.2721, lng: -121.9399 },
    'Sonoma County': { lat: 38.578, lng: -122.9888 },
  };

  const COUNTY_TO_CITY: Record<string, string> = {
    'Alameda County': 'Oakland',
    'Contra Costa County': 'Concord',
    'Marin County': 'San Rafael',
    'Napa County': 'Napa',
    'San Francisco': 'San Francisco',
    'San Mateo County': 'Redwood City',
    'Santa Clara County': 'San Jose',
    'Solano County': 'Fairfield',
    'Sonoma County': 'Santa Rosa',
  };

  // Location state
  let currentLocation: { source: string; county: string; city?: string; input?: string } | null =
    null;

  // Type-ahead elements
  const typeaheadDropdown = document.getElementById('typeahead-dropdown');
  const typeaheadList = document.getElementById('typeahead-list');
  let selectedSuggestionIndex = -1;

  // expandWithSynonyms, rewriteQuery, getBestBets → window.SearchEngine

  // Show type-ahead suggestions
  function showTypeahead(query: string) {
    if (!typeaheadDropdown || !typeaheadList || query.length < 2) {
      hideTypeahead();
      return;
    }

    const queryLower = query.toLowerCase();
    const matches = SUGGESTIONS.filter((s) => s.toLowerCase().includes(queryLower)).slice(0, 6);

    if (matches.length === 0) {
      hideTypeahead();
      return;
    }

    typeaheadList.innerHTML = matches
      .map(
        (suggestion, i) => `
      <li role="option"
          class="typeahead-item ${i === selectedSuggestionIndex ? 'selected' : ''}"
          data-suggestion="${suggestion}">
        <svg class="w-4 h-4 text-neutral-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <span>${highlightMatch(suggestion, query)}</span>
      </li>
    `
      )
      .join('');

    typeaheadDropdown.classList.remove('hidden');

    // Add click handlers
    typeaheadList.querySelectorAll('.typeahead-item').forEach((item) => {
      item.addEventListener('click', () => {
        const suggestion = (item as HTMLElement).dataset.suggestion;
        if (suggestion && searchInput) {
          (searchInput as HTMLInputElement).value = suggestion;
          hideTypeahead();
          void performSearch();
        }
      });
    });
  }

  function hideTypeahead() {
    typeaheadDropdown?.classList.add('hidden');
    selectedSuggestionIndex = -1;
  }

  function highlightMatch(text: string, query: string): string {
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return text.replace(regex, '<strong>$1</strong>');
  }

  // Handle keyboard navigation for type-ahead
  function handleTypeaheadKeydown(e: KeyboardEvent) {
    const items = typeaheadList?.querySelectorAll('.typeahead-item') || [];
    if (items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedSuggestionIndex = Math.min(selectedSuggestionIndex + 1, items.length - 1);
      updateTypeaheadSelection(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedSuggestionIndex = Math.max(selectedSuggestionIndex - 1, -1);
      updateTypeaheadSelection(items);
    } else if (e.key === 'Tab' && selectedSuggestionIndex >= 0) {
      e.preventDefault();
      const selected = items[selectedSuggestionIndex] as HTMLElement;
      const suggestion = selected?.dataset?.suggestion;
      if (suggestion && searchInput) {
        (searchInput as HTMLInputElement).value = suggestion;
        hideTypeahead();
      }
    } else if (e.key === 'Escape') {
      hideTypeahead();
    }
  }

  function updateTypeaheadSelection(items: NodeListOf<Element>) {
    items.forEach((item, i) => {
      if (i === selectedSuggestionIndex) {
        item.classList.add('selected');
      } else {
        item.classList.remove('selected');
      }
    });
  }

  // Build search index from program cards on directory page
  const cards = document.querySelectorAll('[data-category]');

  const programs = Array.from(cards).map((card, index) => {
    const id = card.getAttribute('data-program-id') || card.id?.replace('program-', '') || '';
    const groups = (card.getAttribute('data-groups') || '')
      .split(',')
      .map((group) => group.trim())
      .filter(Boolean);

    return {
      index,
      element: card,
      id,
      category: card.getAttribute('data-category') || '',
      area: card.getAttribute('data-area') || '',
      groups,
      verified: card.getAttribute('data-verified') === 'true',
    };
  });

  const programById = new Map(programs.map((program) => [program.id, program]));
  const originalOrder = programs.map((program) => program.element);
  const resultsContainer = document.getElementById('programs-grid');

  // Shared Meilisearch config — single source of truth for all search surfaces
  import { searchMeilisearch as sharedSearchMeilisearch } from '@/lib/search';
  import { MEILISEARCH_CONFIG, FUSE_SEARCH_KEYS, FUSE_OPTIONS } from '@/lib/search-config';
  import { resolveLocationInput, buildCountiesFilter } from '@/lib/location';

  const MEILI_BASE_URL = import.meta.env.DEV
    ? MEILISEARCH_CONFIG.devBaseUrl
    : MEILISEARCH_CONFIG.baseUrl;

  // Detect if accessing via Tor (.onion) - Meilisearch won't work over Tor, use Fuse.js fallback
  const isOnionSite = typeof window !== 'undefined' && window.location.hostname.endsWith('.onion');
  const USE_MEILISEARCH = !isOnionSite;

  const searchInput = document.getElementById('search-input');
  const searchHints = document.getElementById('search-hints');
  const hintButtons = document.querySelectorAll('.search-hint-btn');
  const inlineClearBtn = document.getElementById('search-clear-btn');
  const searchSubmitBtn = document.getElementById('search-submit-btn');

  // Aria-live announcers for screen readers
  const searchAnnouncer = document.getElementById('search-announcer');
  const urgentAnnouncer = document.getElementById('search-urgent-announcer');

  // Announce search results to screen readers
  function announceToScreenReader(message: string, urgent = false) {
    const announcer = urgent ? urgentAnnouncer : searchAnnouncer;
    if (announcer) {
      // Clear and re-set to ensure announcement
      announcer.textContent = '';
      setTimeout(() => {
        announcer.textContent = message;
      }, 100);
    }
  }

  let activeCategory = 'all';

  function updateInputState() {
    if (!searchInput) return;
    const hasValue = searchInput.value.trim().length > 0;
    inlineClearBtn?.classList.toggle('hidden', !hasValue);
    searchHints?.classList.toggle('hidden', hasValue);
  }

  updateInputState();

  function getActiveFilters() {
    const categorySelect = document.getElementById('category-select') as HTMLSelectElement | null;
    const verifiedCheckbox = document.getElementById('verified-only') as HTMLInputElement | null;
    const activeGroupBtn = document.querySelector('.group-filter-btn[data-active="true"]');
    const categoryValue = categorySelect?.value || activeCategory || 'all';

    return {
      category: categoryValue.toLowerCase(),
      group: activeGroupBtn?.getAttribute('data-group') || null,
      verifiedOnly: verifiedCheckbox?.checked || false,
    };
  }

  function matchesActiveFilters(program) {
    const filters = getActiveFilters();
    const programCategory = program.category || '';
    const matchesCategory =
      filters.category === 'all' || programCategory.toLowerCase() === filters.category;
    const matchesGroup = !filters.group || program.groups.includes(filters.group);
    const matchesVerified = !filters.verifiedOnly || program.verified;
    const locationHidden = program.element.hasAttribute('data-location-hidden');

    return matchesCategory && matchesGroup && matchesVerified && !locationHidden;
  }

  function getProgramName(id: string) {
    const docName = window.SearchEngine.getSearchDocumentsById().get(id)?.name;
    if (docName) return docName;

    const program = programById.get(id);
    const nameEl = program?.element.querySelector('[data-program-name]');
    return nameEl?.textContent?.trim() || '';
  }

  function shouldApplyRelevanceOrder() {
    const relevanceBtn = document.getElementById('sort-relevance');
    const alphaBtn = document.getElementById('sort-alpha');
    if (!relevanceBtn || !alphaBtn) {
      return true;
    }

    return relevanceBtn.getAttribute('aria-checked') === 'true';
  }

  function applyRelevanceOrder(rankedIds: string[]) {
    if (!shouldApplyRelevanceOrder()) return;
    if (!resultsContainer) return;
    const rankedSet = new Set(rankedIds);
    const orderedPrograms = [
      ...rankedIds.map((id) => programById.get(id)).filter((program) => program),
      ...programs.filter((program) => !rankedSet.has(program.id)),
    ];

    orderedPrograms.forEach((program) => {
      const node = program.element;
      if (node && resultsContainer.contains(node)) {
        resultsContainer.appendChild(node);
      }
    });
  }

  function resetRelevanceOrder() {
    if (!shouldApplyRelevanceOrder()) return;
    if (!resultsContainer) return;
    originalOrder.forEach((node) => {
      if (resultsContainer.contains(node)) {
        resultsContainer.appendChild(node);
      }
    });
  }

  function setRelevanceRanks(rankedIds: string[]) {
    const rankById = new Map(rankedIds.map((id, index) => [id, index]));
    programs.forEach((program) => {
      const rank = rankById.get(program.id);
      if (rank === undefined) {
        program.element.removeAttribute('data-relevance-rank');
        return;
      }
      program.element.setAttribute('data-relevance-rank', String(rank));
    });
  }

  // =========================================================================
  // Initialize extracted modules
  // =========================================================================

  // Initialize SearchCrisis
  window.SearchCrisis.init({
    announceToScreenReader,
  });

  // Initialize SearchEngine (also kicks off search index loading)
  window.SearchEngine.init({
    searchConfig: { synonyms: SYNONYMS, best_bets: BEST_BETS, query_rewrites: QUERY_REWRITES },
    zipToCityMap: ZIP_TO_CITY,
    cityToCountyMap: CITY_TO_COUNTY,
    programs,
    programById,
    matchesActiveFilters,
    getProgramName,
    FuseConstructor: Fuse,
    fuseSearchKeys: FUSE_SEARCH_KEYS,
    fuseOptions: FUSE_OPTIONS,
    sharedSearchMeilisearch,
    resolveLocationInput,
    buildCountiesFilter,
    meiliBaseUrl: MEILI_BASE_URL,
    useMeilisearch: USE_MEILISEARCH,
    getCurrentLocation: () => currentLocation,
    getActiveFilters,
  });

  // Initialize SearchRefinement
  window.SearchRefinement.init({
    announceToScreenReader,
    searchEngine: window.SearchEngine,
    programs,
    programById,
    matchesActiveFilters,
    setRelevanceRanks,
    applyRelevanceOrder,
    updateResultsCount,
    searchInput: searchInput as HTMLInputElement,
    getCurrentLocation: () => currentLocation,
    countyToCity: COUNTY_TO_CITY,
  });

  // Track active category filter
  document.addEventListener('click', (e) => {
    const filterBtn = e.target.closest('[data-filter]');
    if (filterBtn) {
      activeCategory = filterBtn.getAttribute('data-filter') || 'all';
      void performSearch();
    }
  });

  async function performFuzzySearch(query) {
    await window.SearchEngine.ensureFuseReady();

    if (!query) {
      // No search query - show all (respect category filter)
      programs.forEach((p) => {
        const shouldShow = matchesActiveFilters(p);
        p.element.style.display = shouldShow ? '' : 'none';
        p.element.classList.remove('best-bet');
        p.element.removeAttribute('data-relevance-rank');
      });
      resetRelevanceOrder();
    } else {
      // Apply search enhancements
      const rewrittenQuery = window.SearchEngine.rewriteQuery(query);
      const bestBetIds = new Set(window.SearchEngine.getBestBets(query));

      // Try Meilisearch first (typo-tolerant), fall back to Fuse.js
      let resultsById = await window.SearchEngine.tryMeilisearchSearch(rewrittenQuery);
      if (!resultsById) {
        // Meilisearch unavailable or returned no results - use Fuse.js
        const expandedTerms = window.SearchEngine.expandWithSynonyms(rewrittenQuery);
        resultsById = window.SearchEngine.collectSearchResults(expandedTerms);
      }

      const rankedIds = window.SearchEngine.rankSearchResults(resultsById, Array.from(bestBetIds));
      const matchedIds = new Set(rankedIds);
      setRelevanceRanks(rankedIds);
      applyRelevanceOrder(rankedIds);

      programs.forEach((p) => {
        const matchesSearch = matchedIds.has(p.id);
        const isBestBet = bestBetIds.has(p.id);
        const shouldShow = matchesSearch;

        p.element.style.display = shouldShow ? '' : 'none';

        // Mark best bets for styling
        if (isBestBet && shouldShow) {
          p.element.classList.add('best-bet');
        } else {
          p.element.classList.remove('best-bet');
        }
      });
    }

    // Update count
    const visibleCount = document.querySelectorAll(
      '[data-category]:not([style*="display: none"])'
    ).length;
    updateResultsCount(visibleCount, query);

    // Announce results to screen readers
    if (query) {
      if (visibleCount === 0) {
        announceToScreenReader(`No programs found for "${query}". Try different search terms.`);
      } else {
        announceToScreenReader(
          `Found ${visibleCount} program${visibleCount !== 1 ? 's' : ''} for "${query}"`
        );
      }
    }

    // Check if refinement bar should be shown
    window.SearchRefinement.checkAndShowRefinement(query, visibleCount);
  }

  function updateResultsCount(count, query) {
    const counter = document.getElementById('results-count');
    if (counter) {
      const queryInfo = query ? ` for "${query}"` : '';
      counter.textContent = `${count} program${count !== 1 ? 's' : ''} found${queryInfo}`;
    }
  }

  // checkForCrisis, showCrisisBanner → window.SearchCrisis

  async function performSearch() {
    const query = searchInput?.value.trim() || '';

    // Check for crisis keywords first - show banner but ALSO show relevant programs
    const crisisType = window.SearchCrisis.checkForCrisis(query);
    if (crisisType) {
      window.SearchCrisis.showCrisisBanner(crisisType);
      // Continue with fuzzy search to show relevant mental health resources
      await performFuzzySearch(query);
      return;
    }

    await performFuzzySearch(query);
  }

  // Handle Enter key - perform search only on Enter
  searchInput?.addEventListener('keydown', (e) => {
    // Handle type-ahead keyboard navigation
    if (typeaheadDropdown && !typeaheadDropdown.classList.contains('hidden')) {
      handleTypeaheadKeydown(e);
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') return;
      if (e.key === 'Tab' && selectedSuggestionIndex >= 0) return;
    }

    if (e.key === 'Enter') {
      e.preventDefault();
      hideTypeahead();

      // If a suggestion is selected, use it
      if (selectedSuggestionIndex >= 0) {
        const items = typeaheadList?.querySelectorAll('.typeahead-item') || [];
        const selected = items[selectedSuggestionIndex] as HTMLElement;
        if (selected?.dataset?.suggestion) {
          (searchInput as HTMLInputElement).value = selected.dataset.suggestion;
        }
      }

      void performSearch();
      updateInputState();
    } else if (e.key === 'Escape') {
      if (searchInput.value.trim().length > 0) {
        searchInput.value = '';
        hideTypeahead();
        selectedSuggestionIndex = -1;
        void performFuzzySearch('');
        updateInputState();
      } else {
        hideTypeahead();
      }
    }
  });

  // Debounce helper
  let searchTimeout: ReturnType<typeof setTimeout> | null = null;
  const SEARCH_DEBOUNCE_MS = 250;

  function debouncedSearch(query: string) {
    if (searchTimeout) {
      clearTimeout(searchTimeout);
    }

    // Show loading state immediately for better feedback
    if (query.length >= 2) {
      searchInput?.classList.add('searching');
    }

    searchTimeout = setTimeout(() => {
      void performSearch();
      searchInput?.classList.remove('searching');
    }, SEARCH_DEBOUNCE_MS);
  }

  // Search as user types (debounced)
  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value;
    showTypeahead(query);
    updateInputState();

    // Trigger debounced search for queries 2+ chars
    if (query.length >= 2 || query.length === 0) {
      debouncedSearch(query);
    }
  });

  // Hide type-ahead when clicking outside
  document.addEventListener('click', (e) => {
    if (
      !searchInput?.contains(e.target as Node) &&
      !typeaheadDropdown?.contains(e.target as Node)
    ) {
      hideTypeahead();
    }
  });

  // Handle hint button clicks
  hintButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      searchInput.value = btn.textContent || '';
      hideTypeahead();
      void performSearch();
      updateInputState();
      searchInput.focus();
    });
  });

  searchSubmitBtn?.addEventListener('click', () => {
    hideTypeahead();
    void performSearch();
    updateInputState();
    searchInput?.focus();
  });

  inlineClearBtn?.addEventListener('click', () => {
    if (!searchInput) return;
    searchInput.value = '';
    selectedSuggestionIndex = -1;
    hideTypeahead();
    void performFuzzySearch('');
    updateInputState();
    searchInput.focus();
  });

  // Listen for location changes to re-apply search + sync county filter pills
  window.addEventListener('locationChanged', () => {
    // Auto-select matching county pill on directory page when location changes
    if (currentLocation?.county) {
      const resolved = resolveLocationInput(
        currentLocation.city || currentLocation.county,
        ZIP_TO_CITY,
        CITY_TO_COUNTY
      );
      if (resolved) {
        // Click the matching county pill to sync DOM filtering with Meilisearch filtering
        const countyBtn = document.querySelector(
          `.county-filter-btn[data-county="${resolved.countySlug}"]`
        ) as HTMLElement | null;
        if (countyBtn && countyBtn.getAttribute('aria-pressed') !== 'true') {
          countyBtn.click();
        }
      }
    }

    if (searchInput.value) {
      void performSearch();
    }
  });

  // Clear search button
  document.getElementById('clear-search')?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      void performFuzzySearch('');
      searchInput.focus();
      updateInputState();
    }
  });

  // Refinement bar functions → window.SearchRefinement

  // Refinement bar DOM refs (still needed for GPS/location handlers)
  const useGpsBtn = document.getElementById('use-gps-btn');
  const zipCityInput = document.getElementById('zip-city-input') as HTMLInputElement | null;
  const submitLocationBtn = document.getElementById('submit-location-btn');
  const changeLocationBtn = document.getElementById('change-location-btn');

  // Capitalize city name for display
  function capitalizeCityName(city: string): string {
    return city
      .split(' ')
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');
  }

  // GPS location handler
  useGpsBtn?.addEventListener('click', async () => {
    if (!navigator.geolocation) {
      announceToScreenReader('Geolocation is not supported by your browser.');
      return;
    }

    const originalText = useGpsBtn.textContent;
    useGpsBtn.textContent = 'Getting location...';
    (useGpsBtn as HTMLButtonElement).disabled = true;

    navigator.geolocation.getCurrentPosition(
      (position) => {
        const { latitude, longitude } = position.coords;
        const county = findNearestCounty(latitude, longitude);
        const city = COUNTY_TO_CITY[county];

        currentLocation = {
          source: 'gps',
          county: county,
          city: city,
        };

        window.SearchRefinement.updateLocationDisplay();
        localStorage.setItem('baynavigator_location', JSON.stringify(currentLocation));

        useGpsBtn.textContent = originalText;
        (useGpsBtn as HTMLButtonElement).disabled = false;

        announceToScreenReader(`Location set to ${city ? capitalizeCityName(city) : county}.`);
      },
      () => {
        announceToScreenReader('Could not get your location. Please enter a ZIP code or city.');
        useGpsBtn.textContent = originalText;
        (useGpsBtn as HTMLButtonElement).disabled = false;
      },
      { enableHighAccuracy: false, timeout: 10000 }
    );
  });

  // Handle location submission from ZIP/city input
  function handleLocationSubmit() {
    if (!zipCityInput) return;
    const value = zipCityInput.value.trim();
    if (!value) return;

    const result = lookupCountyAndCity(value);
    if (result) {
      currentLocation = {
        source: 'manual',
        input: value,
        county: result.county,
        city: result.city,
      };
      window.SearchRefinement.updateLocationDisplay();
      updateLocationQuickButton();
      localStorage.setItem('baynavigator_location', JSON.stringify(currentLocation));
      const locationName = result.city
        ? capitalizeCityName(result.city)
        : COUNTY_TO_CITY[result.county] || result.county;
      announceToScreenReader(`Location set to ${locationName}.`);
      window.dispatchEvent(new CustomEvent('locationChanged'));
    } else {
      zipCityInput.classList.add('border-red-500', 'focus:ring-red-500');
      zipCityInput.placeholder = 'Not found - try another';
      setTimeout(() => {
        zipCityInput.classList.remove('border-red-500', 'focus:ring-red-500');
        zipCityInput.placeholder = 'ZIP code or city';
      }, 3000);
      announceToScreenReader('Location not found. Please try a different ZIP code or city.');
    }
  }

  submitLocationBtn?.addEventListener('click', handleLocationSubmit);
  zipCityInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleLocationSubmit();
    }
  });

  changeLocationBtn?.addEventListener('click', () => {
    const locationDisplay = document.getElementById('location-display');
    const locationPrompt = document.getElementById('location-prompt');
    if (locationDisplay) locationDisplay.classList.add('hidden');
    if (locationPrompt) locationPrompt.classList.remove('hidden');
    if (zipCityInput) {
      zipCityInput.value = '';
      zipCityInput.focus();
    }
  });

  // Find nearest county from GPS coordinates using Haversine formula
  function findNearestCounty(lat: number, lng: number): string {
    let nearest = 'Bay Area';
    let minDist = Infinity;

    for (const [county, coords] of Object.entries(COUNTY_COORDINATES)) {
      const dist = haversineDistance(lat, lng, coords.lat, coords.lng);
      if (dist < minDist) {
        minDist = dist;
        nearest = county;
      }
    }

    return nearest;
  }

  // Haversine distance calculation
  function haversineDistance(lat1: number, lng1: number, lat2: number, lng2: number): number {
    const R = 3959; // Earth radius in miles
    const dLat = ((lat2 - lat1) * Math.PI) / 180;
    const dLng = ((lng2 - lng1) * Math.PI) / 180;
    const a =
      Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos((lat1 * Math.PI) / 180) *
        Math.cos((lat2 * Math.PI) / 180) *
        Math.sin(dLng / 2) *
        Math.sin(dLng / 2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // Lookup county and city from ZIP or city name
  function lookupCountyAndCity(input: string): { county: string; city?: string } | null {
    // Use shared resolver with YAML-sourced data (430+ ZIPs, 150+ cities)
    const resolved = resolveLocationInput(input, ZIP_TO_CITY, CITY_TO_COUNTY);
    if (resolved) {
      return { county: resolved.countyName, city: resolved.city };
    }
    return null;
  }

  // Load saved location from localStorage
  function loadSavedLocation() {
    const saved = localStorage.getItem('baynavigator_location');
    if (saved) {
      try {
        currentLocation = JSON.parse(saved);
      } catch {
        currentLocation = null;
      }
    }
  }

  // Initialize refinement
  loadSavedLocation();

  // Refinement bar will show based on the search results (handled via window.SearchRefinement)

  // =========================================================================
  // INLINE LOCATION FIELD HANDLERS
  // =========================================================================
  const locationQuickText = document.getElementById('location-quick-text');
  const locationInput = document.getElementById('location-input') as HTMLInputElement | null;
  const detectLocationBtn = document.getElementById('detect-location-btn');

  // Update the location display in both the hidden span and the inline input
  function updateLocationQuickButton() {
    if (currentLocation) {
      const fallbackCity = COUNTY_TO_CITY[currentLocation.county];
      const displayName = currentLocation.city
        ? capitalizeCityName(currentLocation.city)
        : fallbackCity || currentLocation.county;
      if (locationQuickText) locationQuickText.textContent = displayName;
      if (locationInput) locationInput.value = displayName;
      // Also store for API calls
      localStorage.setItem('userLocation', currentLocation.city || fallbackCity || '');
      localStorage.setItem('userCounty', currentLocation.county || '');
    } else {
      if (locationQuickText) locationQuickText.textContent = 'Set location';
      if (locationInput) locationInput.value = '';
      localStorage.removeItem('userLocation');
      localStorage.removeItem('userCounty');
    }
  }

  // "Near me" GPS button
  detectLocationBtn?.addEventListener('click', async () => {
    if (!navigator.geolocation) {
      announceToScreenReader('Geolocation is not supported by your browser.');
      return;
    }

    const originalText = detectLocationBtn.textContent;
    detectLocationBtn.textContent = 'Locating\u2026';
    (detectLocationBtn as HTMLButtonElement).disabled = true;

    navigator.geolocation.getCurrentPosition(
      (position) => {
        const { latitude, longitude } = position.coords;
        const county = findNearestCounty(latitude, longitude);

        currentLocation = {
          source: 'gps',
          county: county,
        };

        window.SearchRefinement.updateLocationDisplay();
        updateLocationQuickButton();
        localStorage.setItem('baynavigator_location', JSON.stringify(currentLocation));

        detectLocationBtn.textContent = originalText;
        (detectLocationBtn as HTMLButtonElement).disabled = false;

        announceToScreenReader(`Location set to ${county}.`);
      },
      () => {
        announceToScreenReader('Could not get your location. Please enter a ZIP code or city.');
        detectLocationBtn.textContent = originalText;
        (detectLocationBtn as HTMLButtonElement).disabled = false;
      },
      { enableHighAccuracy: false, timeout: 10000 }
    );
  });

  // Handle location input submission (Enter key or blur)
  function handleLocationInputSubmit() {
    if (!locationInput) return;
    const value = locationInput.value.trim();
    if (!value) return;

    const result = lookupCountyAndCity(value);
    if (result) {
      currentLocation = {
        source: 'manual',
        input: value,
        county: result.county,
        city: result.city,
      };
      window.SearchRefinement.updateLocationDisplay();
      updateLocationQuickButton();
      localStorage.setItem('baynavigator_location', JSON.stringify(currentLocation));
      const locationName = result.city
        ? capitalizeCityName(result.city)
        : COUNTY_TO_CITY[result.county] || result.county;
      announceToScreenReader(`Location set to ${locationName}.`);
      // Dispatch event to trigger re-search with new location
      window.dispatchEvent(new CustomEvent('locationChanged'));
    } else {
      // Show visual feedback for invalid location
      locationInput.value = '';
      locationInput.placeholder = 'Not found \u2014 try another';
      setTimeout(() => {
        locationInput.placeholder = 'City or ZIP';
      }, 3000);
      announceToScreenReader('Location not found. Please try a different ZIP code or city.');
    }
  }

  locationInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleLocationInputSubmit();
    }
  });

  // Initialize location display on load
  updateLocationQuickButton();

  // Initialize search from URL query parameter
  // This enables deep-linking to search results (e.g., from Carl assistant links)
  const urlParams = new URLSearchParams(window.location.search);
  const initialQuery = urlParams.get('q');
  if (initialQuery && searchInput) {
    (searchInput as HTMLInputElement).value = initialQuery;
    updateInputState();
    // Perform the search after a short delay to ensure DOM is ready
    setTimeout(() => {
      void performSearch();
    }, 100);
  }
</script>

<style>
  @reference "../styles/global.css";
