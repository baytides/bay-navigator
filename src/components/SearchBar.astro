    @apply relative;
  }

  .search-hints {
    @apply flex items-center gap-2 text-sm;
  }

  .search-hints-label {
    @apply text-xs font-medium text-neutral-700 dark:text-neutral-300;
  }

  .search-hints-list {
    @apply flex flex-wrap gap-1.5;
  }

  .search-hint-btn {
    @apply rounded-full border border-neutral-200/60 bg-white/60 px-2.5 py-1 text-xs text-neutral-700 transition-all duration-150;
    @apply hover:border-primary-300 hover:bg-primary-50 hover:text-primary-700 hover:scale-105;
    @apply dark:border-neutral-700/60 dark:bg-neutral-800/60 dark:text-neutral-300;
    @apply dark:hover:border-primary-600 dark:hover:bg-primary-900/30 dark:hover:text-primary-300;
  }

  /* Crisis Banner Styles */
