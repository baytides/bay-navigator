---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

/**
 * Carl's web chat was retired on 2026-09-16.
 *
 * The chat ran against a self-hosted Ollama server (qwen2.5:3b-instruct) over a
 * Cloudflare Tunnel. That server is shut down, so rather than show a chat box
 * that always fails, this page explains where Carl went.
 *
 * The URL is kept alive deliberately: it is linked from the apps, printed
 * material and people's bookmarks. Anyone landing here needs help now, so the
 * page leads with the directory search (which works, entirely in-browser) and
 * 2-1-1 (which reaches a human), not with an app install.
 */

const title = 'Where Carl went';
const description =
  'Carl, the Bay Navigator assistant, now runs on your device or inside your own AI chatbot. Search the full directory here, or dial 2-1-1 to reach a person.';
---

<BaseLayout title={title} description={description}>
  <section class="section py-4">
    <div class="container-page">
      <Breadcrumb items={[{ label: 'Carl', current: true }]} />
    </div>
  </section>

  <section class="section pt-0">
    <div class="container-page max-w-3xl mx-auto w-full px-4 sm:px-6">
      <!-- Header -->
      <div class="text-center mb-8">
        <div
          class="inline-flex items-center justify-center w-16 h-16 bg-primary-100 dark:bg-primary-900/30 rounded-full mb-4"
        >
          <!-- Cloud icon for Karl the Fog -->
          <svg
            class="w-8 h-8 text-primary-700 dark:text-primary-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"
            ></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-neutral-900 dark:text-white mb-3">{title}</h1>
        <p class="text-neutral-700 dark:text-neutral-300">
          Carl's chat window on this website has been switched off. Everything Carl knew is still
          here, and the fastest ways to get help are below.
        </p>
      </div>

      <!-- Need help right now -->
      <div
        class="bg-primary-50 dark:bg-primary-950/40 border border-primary-200 dark:border-primary-800 rounded-xl p-6 mb-8"
      >
        <h2 class="font-semibold text-neutral-900 dark:text-white mb-3">Need help right now?</h2>
        <ul class="space-y-3 text-neutral-700 dark:text-neutral-300">
          <li>
            <a href="/directory" class="text-primary-700 dark:text-primary-300 font-medium"
              >Search the directory</a
            > — all 800+ programs, searchable in your browser. No account, nothing sent anywhere.
          </li>
          <li>
            <a href="tel:211" class="text-primary-700 dark:text-primary-300 font-medium"
              >Dial 2-1-1</a
            > — free, 24/7, over 180 languages. A trained person will talk through your situation with
            you.
          </li>
          <li>
            <a href="tel:988" class="text-primary-700 dark:text-primary-300 font-medium">Dial 988</a
            >
            — the Suicide &amp; Crisis Lifeline, 24/7, call or text.
          </li>
        </ul>
      </div>

      <!-- Where Carl lives now -->
      <h2 class="text-xl font-semibold text-neutral-900 dark:text-white mb-4">
        Carl still exists — he just moved
      </h2>
      <p class="text-neutral-700 dark:text-neutral-300 mb-6">
        Running our own AI server meant paying to keep a machine powered up around the clock so it
        could answer a handful of questions. Carl now runs on hardware that is already switched on —
        either your phone or an AI app you already use. That is cheaper, faster, and keeps your
        questions closer to you.
      </p>

      <div class="grid gap-4 md:grid-cols-2 mb-8">
        <div
          class="bg-white dark:bg-neutral-800 rounded-xl p-5 border border-neutral-200 dark:border-neutral-700"
        >
          <h3 class="font-semibold text-neutral-900 dark:text-white mb-2">On your phone or Mac</h3>
          <p class="text-neutral-700 dark:text-neutral-300 text-sm mb-3">
            The Bay Navigator app runs Carl directly on your device using Apple Intelligence. Your
            questions never leave your phone, and it works without a signal.
          </p>
          <a href="/download" class="text-primary-700 dark:text-primary-300 font-medium text-sm"
            >Get the app</a
          >
        </div>

        <div
          class="bg-white dark:bg-neutral-800 rounded-xl p-5 border border-neutral-200 dark:border-neutral-700"
        >
          <h3 class="font-semibold text-neutral-900 dark:text-white mb-2">
            In your own AI chatbot
          </h3>
          <p class="text-neutral-700 dark:text-neutral-300 text-sm mb-3">
            Carl is available as an MCP server, so ChatGPT, Claude and other assistants can look up
            Bay Area programs and local ordinances directly.
          </p>
          <a href="/developers" class="text-primary-700 dark:text-primary-300 font-medium text-sm"
            >How to connect it</a
          >
        </div>
      </div>

      <p class="text-sm text-neutral-500 dark:text-neutral-300 text-center">
        Still named after <strong>Karl the Fog</strong> — with a <strong>C</strong>, because he
        started out as the <strong>C</strong>hat.
      </p>
    </div>
  </section>
</BaseLayout>
