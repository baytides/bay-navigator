---
/**
 * Individual program page.
 *
 * All 823 programs previously lived on a single URL. /directory rendered every
 * one of them into a 6.8 MB HTML document titled "Directory | Bay Navigator",
 * detail opened in a JS modal, and "share" produced /directory#some-id — which
 * search engines collapse to the parent page. Two consequences:
 *
 *   1. No program could rank for its own name. One page cannot serve 823
 *      distinct queries.
 *   2. The referral case was structurally broken. A case manager sharing
 *      "Alameda County Community Food Bank" sent their client a 6.8 MB page
 *      with no way to find the program on it.
 *
 * This route follows the pattern already proven by src/pages/alerts/[id].astro:
 * getStaticPaths over a generated JSON feed.
 */
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const file = path.join(process.cwd(), 'public', 'api', 'programs.json');
  const payload = JSON.parse(fs.readFileSync(file, 'utf-8'));
  const programs = payload.programs || payload;

  return programs
    .filter((p: any) => p && p.id && p.name)
    .map((program: any) => ({ params: { slug: program.id }, props: { program } }));
}

const { program } = Astro.props;

const CATEGORY_LABELS: Record<string, string> = {
  community: 'Community',
  education: 'Education',
  employment: 'Employment',
  equipment: 'Equipment',
  'federal-benefits': 'Federal Benefits',
  finance: 'Finance',
  food: 'Food',
  health: 'Health',
  housing: 'Housing',
  legal: 'Legal',
  lgbtq: 'LGBTQ+',
  'library-resources': 'Library Resources',
  'pet-resources': 'Pet Resources',
  recreation: 'Recreation',
  retail: 'Retail',
  safety: 'Safety',
  technology: 'Technology',
  transportation: 'Transportation',
  utilities: 'Utilities',
};

const categoryLabel = CATEGORY_LABELS[program.category] || program.category || 'Programs';
const areas: string[] = Array.isArray(program.areas) ? program.areas : [];
const areaLabel = program.city || areas[0] || 'Bay Area';

/**
 * 64 programs ship Markdown bold in fields that are rendered as plain text,
 * so 628 literal ** sequences appear on the directory page today. Strip the
 * markers rather than shipping raw source markup to the reader.
 */
function plain(value: unknown): string {
  return String(value ?? '')
    .replace(/\*\*(.+?)\*\*/g, '$1')
    .replace(/^\s*[-*]\s+/gm, '')
    .trim();
}

/** Split newline-delimited YAML prose into real list items. */
function lines(value: unknown): string[] {
  return String(value ?? '')
    .split('\n')
    .map((l) => plain(l.replace(/^\s*\d+\.\s*/, '')))
    .filter(Boolean);
}

const offers = lines(program.whatTheyOffer);
const steps = lines(program.howToGetIt);
const description = plain(program.fullDescription || program.description);
const shortDescription = plain(program.description);

const telHref = program.phone ? `tel:${String(program.phone).replace(/[^\d+]/g, '')}` : null;
const mapHref = program.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(program.address)}`
  : null;

const siteUrl = 'https://baynavigator.org';
const pageUrl = `${siteUrl}/programs/${program.id}/`;

// Titles carry the terms people actually search: program name, what it is,
// and where. "Directory | Bay Navigator" ranked for none of them.
const pageTitle = `${program.name} — ${categoryLabel} in ${areaLabel}`;
const metaDescription =
  shortDescription.length > 20
    ? shortDescription.slice(0, 155)
    : `${program.name}: ${categoryLabel.toLowerCase()} assistance in ${areaLabel}. Free to use, no account needed.`;

const governmentService: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentService',
  name: program.name,
  description: description || shortDescription,
  url: pageUrl,
  serviceType: categoryLabel,
  areaServed: areas.length
    ? areas.map((a) => ({ '@type': 'AdministrativeArea', name: a }))
    : { '@type': 'AdministrativeArea', name: 'San Francisco Bay Area' },
  ...(program.agency
    ? { provider: { '@type': 'GovernmentOrganization', name: program.agency } }
    : {}),
  ...(program.website || telHref
    ? {
        availableChannel: {
          '@type': 'ServiceChannel',
          ...(program.website ? { serviceUrl: program.website } : {}),
          ...(program.phone ? { servicePhone: String(program.phone) } : {}),
        },
      }
    : {}),
};

const breadcrumbs: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Programs', item: `${siteUrl}/directory/` },
    { '@type': 'ListItem', position: 3, name: program.name, item: pageUrl },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  type="article"
  modifiedTime={program.lastUpdated || undefined}
  schemas={[governmentService, breadcrumbs]}
>
  <section class="section py-4">
    <div class="container-page">
      <Breadcrumb
        items={[
          { label: 'Programs', href: '/directory' },
          { label: program.name, current: true },
        ]}
      />
    </div>
  </section>

  <article class="section pb-12">
    <div class="container-page max-w-3xl">
      <p
        class="text-sm font-semibold uppercase tracking-wide text-primary-800 dark:text-primary-300"
      >
        {categoryLabel}
      </p>
      <h1 class="mt-2 text-3xl font-bold text-neutral-900 dark:text-white sm:text-4xl">
        {program.name}
      </h1>
      {
        shortDescription && (
          <p class="mt-3 text-lg text-neutral-700 dark:text-neutral-200">{shortDescription}</p>
        )
      }

      {/* Contact first. For someone in crisis the phone number is the page. */}
      {
        (telHref || program.website || mapHref) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {telHref && (
              <a
                href={telHref}
                class="btn btn-primary inline-flex min-h-[44px] items-center gap-2 text-base"
              >
                Call {program.phone}
              </a>
            )}
            {program.website && (
              <a
                href={program.website}
                target="_blank"
                rel="noopener noreferrer"
                class="btn inline-flex min-h-[44px] items-center gap-2 border border-neutral-400 text-base dark:border-neutral-600"
              >
                Visit website <span class="sr-only">(opens in a new tab)</span>
              </a>
            )}
            {mapHref && (
              <a
                href={mapHref}
                target="_blank"
                rel="noopener noreferrer"
                class="btn inline-flex min-h-[44px] items-center gap-2 border border-neutral-400 text-base dark:border-neutral-600"
              >
                Directions <span class="sr-only">(opens in a new tab)</span>
              </a>
            )}
          </div>
        )
      }

      {
        description && description !== shortDescription && (
          <div class="mt-8">
            <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">
              About this program
            </h2>
            <p class="mt-2 whitespace-pre-line text-neutral-700 dark:text-neutral-200">
              {description}
            </p>
          </div>
        )
      }

      {
        offers.length > 0 && (
          <div class="mt-8">
            <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">What you get</h2>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-neutral-700 dark:text-neutral-200">
              {offers.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        /* Never collapsed. This is the field that turns a listing into help, and
          it sat inside a <details> behind a click, below the marketing copy. */
      }
      {
        steps.length > 0 && (
          <div class="mt-8">
            <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">How to apply</h2>
            <ol class="mt-2 list-decimal space-y-1 pl-5 text-neutral-700 dark:text-neutral-200">
              {steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          </div>
        )
      }

      <div class="mt-8">
        <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">Details</h2>
        <dl class="mt-2 divide-y divide-neutral-200 dark:divide-neutral-700">
          {
            areas.length > 0 && (
              <div class="flex flex-wrap gap-x-4 py-2">
                <dt class="w-40 font-medium text-neutral-900 dark:text-white">Serves</dt>
                <dd class="flex-1 text-neutral-700 dark:text-neutral-200">{areas.join(', ')}</dd>
              </div>
            )
          }
          {
            program.address && (
              <div class="flex flex-wrap gap-x-4 py-2">
                <dt class="w-40 font-medium text-neutral-900 dark:text-white">Address</dt>
                <dd class="flex-1 text-neutral-700 dark:text-neutral-200">{program.address}</dd>
              </div>
            )
          }
          {
            program.cost && (
              <div class="flex flex-wrap gap-x-4 py-2">
                <dt class="w-40 font-medium text-neutral-900 dark:text-white">Cost</dt>
                <dd class="flex-1 text-neutral-700 dark:text-neutral-200">{plain(program.cost)}</dd>
              </div>
            )
          }
          {
            program.agency && (
              <div class="flex flex-wrap gap-x-4 py-2">
                <dt class="w-40 font-medium text-neutral-900 dark:text-white">Run by</dt>
                <dd class="flex-1 text-neutral-700 dark:text-neutral-200">{program.agency}</dd>
              </div>
            )
          }
          <div class="flex flex-wrap gap-x-4 py-2">
            <dt class="w-40 font-medium text-neutral-900 dark:text-white">Last checked</dt>
            <dd class="flex-1 text-neutral-700 dark:text-neutral-200">
              {program.lastUpdated ? program.lastUpdated : 'Not recorded'} — always call ahead to confirm
              hours.
            </dd>
          </div>
        </dl>
      </div>

      <p class="mt-8 text-sm text-neutral-700 dark:text-neutral-300">
        <a href="/directory" class="underline">Browse all programs</a>
        <span aria-hidden="true"> · </span>
        <a href={`/directory?category=${encodeURIComponent(categoryLabel)}`} class="underline">
          More {categoryLabel.toLowerCase()} programs
        </a>
      </p>
    </div>
  </article>
</BaseLayout>
