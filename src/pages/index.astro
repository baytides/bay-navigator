---
import SiteLayout from '../layouts/SiteLayout.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';

// --- Load all programs and count by category ---
const dataDir = path.join(process.cwd(), 'src/data');
const NON_PROGRAM_FILES = [
  'cities.yml',
  'groups.yml',
  'zipcodes.yml',
  'suppressed.yml',
  'search-config.yml',
  'transit-agencies.yml',
  'county-supervisors.yml',
  'site-config.yml',
  'bay-area-jurisdictions.yml',
  'city-profiles.yml',
  'helplines.yml',
  'custom-themes.yml',
  'chat-messages.yml',
  'homepage-pills.yml',
];

const suppressedFile = path.join(dataDir, 'suppressed.yml');
let suppressedIds = new Set<string>();
if (fs.existsSync(suppressedFile)) {
  const suppressedData = yaml.load(fs.readFileSync(suppressedFile, 'utf8')) as any[];
  if (Array.isArray(suppressedData)) {
    suppressedIds = new Set(suppressedData.map((s) => s.id));
  }
}

const categoryCounts: Record<string, number> = {};
let totalPrograms = 0;
const files = fs
  .readdirSync(dataDir)
  .filter((f) => f.endsWith('.yml') && !NON_PROGRAM_FILES.includes(f));

for (const file of files) {
  const content = fs.readFileSync(path.join(dataDir, file), 'utf8');
  const data = yaml.load(content) as any;
  if (!data) continue;
  const programs = Array.isArray(data) ? data : data.programs || [];
  for (const program of programs) {
    const category =
      program.category ||
      file
        .replace('.yml', '')
        .replace(/-/g, ' ')
        .replace(/\b\w/g, (c: string) => c.toUpperCase());
    const id =
      program.id ||
      `${category.toLowerCase().replace(/\s+/g, '-')}-${(program.name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
    if (!suppressedIds.has(id)) {
      categoryCounts[category] = (categoryCounts[category] || 0) + 1;
      totalPrograms++;
    }
  }
}

// --- Load contextual pills ---
const pillsFile = path.join(dataDir, 'homepage-pills.yml');
let pills: Array<{ label: string; detail: string; href: string; color: string; active: boolean }> =
  [];
try {
  const pillsData = yaml.load(fs.readFileSync(pillsFile, 'utf8')) as any;
  // Expiry is enforced here, not trusted to whoever edits the YAML. A stale
  // dated pill is worse than no pill: it is a visible claim that the site has
  // not been looked at since spring.
  const today = new Date().toISOString().slice(0, 10);
  pills = (pillsData?.pills || []).filter(
    (p: any) => p.active !== false && (!p.expires || String(p.expires) >= today)
  );
} catch {
  // Pills unavailable
}

// --- Load groups for eligibility card ---
const groupsFile = path.join(dataDir, 'groups.yml');
let groups: any[] = [];
try {
  const groupsData = yaml.load(fs.readFileSync(groupsFile, 'utf8')) as any;
  groups = groupsData?.groups || [];
} catch {}

// --- Load search config ---
let searchConfig = { synonyms: {}, best_bets: {}, suggestions: [], query_rewrites: {} };
try {
  const searchConfigPath = path.join(process.cwd(), 'src/data/search-config.yml');
  searchConfig = yaml.load(fs.readFileSync(searchConfigPath, 'utf8')) as typeof searchConfig;
} catch {}

// --- Load location data ---
let homeZipToCity: Record<string, string> = {};
let homeCityToCounty: Record<string, string> = {};
try {
  const citiesData = yaml.load(fs.readFileSync(path.join(dataDir, 'cities.yml'), 'utf8')) as Array<{
    name: string;
    county: string;
  }>;
  for (const city of citiesData) homeCityToCounty[city.name.toLowerCase()] = city.county;
  const zipData = yaml.load(fs.readFileSync(path.join(dataDir, 'zipcodes.yml'), 'utf8')) as Record<
    string,
    string
  >;
  homeZipToCity = Object.fromEntries(
    Object.entries(zipData).map(([zip, city]) => [String(zip), city])
  );
} catch {}

// --- Category counts ---
const foodCount = categoryCounts['Food'] || 0;
const utilityCount = categoryCounts['Utilities'] || 0;
const housingCount = categoryCounts['Housing'] || 0;
const healthCount = categoryCounts['Health'] || 0;
const jobsCount = categoryCounts['Employment'] || 0;
const legalCount = categoryCounts['Legal Services'] || 0;
const transitCount = categoryCounts['Transportation'] || 0;
const educationCount = categoryCounts['Education'] || 0;

// --- SVG icon paths (reusable) ---
const icons = {
  food: '<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>',
  housing:
    '<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>',
  health:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>',
  utilities:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/>',
  jobs: '<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z"/>',
  transit:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>',
  alerts:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>',
  eligibility:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>',
  airplane:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"/>',
};

// --- Categories for the homepage grid ---
//
// Derived from the data, not hand-listed. The previous version hardcoded eight
// tiles against category names that had drifted ("Legal Services" when the data
// says "Legal"), so Legal Help silently vanished from the homepage while
// Recreation — the single biggest category at 203 programs — was never shown at
// all. Anything with programs now gets a tile.
const CATEGORY_META: Record<string, { blurb: string; icon: string }> = {
  Food: { blurb: 'Food banks, CalFresh, free meals and grocery help.', icon: icons.food },
  Housing: { blurb: 'Shelter, rent and deposit help, eviction defense.', icon: icons.housing },
  Health: { blurb: 'Medi-Cal, free clinics, dental and mental health.', icon: icons.health },
  Utilities: {
    blurb: 'CARE, FERA and LIHEAP discounts on power and water.',
    icon: icons.utilities,
  },
  Employment: { blurb: 'Job search, training and unemployment benefits.', icon: icons.jobs },
  Legal: { blurb: 'Free legal aid, immigration and tenant rights.', icon: icons.eligibility },
  Transportation: { blurb: 'Discount transit passes and paratransit rides.', icon: icons.transit },
  Education: { blurb: 'Financial aid, adult school and childcare help.', icon: icons.eligibility },
  Recreation: {
    blurb: 'Free museum days, parks, pools and community classes.',
    icon: icons.airplane,
  },
  'Federal Benefits': {
    blurb: 'Social Security, SSI, SNAP, Medicare and VA programs.',
    icon: icons.eligibility,
  },
  Community: {
    blurb: 'Community centers, volunteering and neighbor support.',
    icon: icons.housing,
  },
  Retail: { blurb: 'Low-income discounts on everyday goods and services.', icon: icons.food },
  Finance: { blurb: 'Free tax prep, banking and debt help.', icon: icons.jobs },
  'Library Resources': {
    blurb: 'Library cards, free wifi, computers and classes.',
    icon: icons.eligibility,
  },
  'Pet Resources': {
    blurb: 'Low-cost vet care, pet food banks and spay/neuter.',
    icon: icons.health,
  },
  Technology: {
    blurb: 'Affordable internet, free devices and digital skills.',
    icon: icons.utilities,
  },
  Lgbtq: { blurb: 'LGBTQ+ health, legal, housing and community support.', icon: icons.health },
  Safety: { blurb: 'Domestic violence, crisis lines and disaster help.', icon: icons.alerts },
  Equipment: { blurb: 'Free or loaned medical and mobility equipment.', icon: icons.health },
};

const DEFAULT_ICON = icons.eligibility;

const categories = Object.entries(categoryCounts)
  .filter(([, count]) => count > 0)
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({
    name: name === 'Lgbtq' ? 'LGBTQ+' : name,
    count,
    href: `/directory?category=${encodeURIComponent(name)}`,
    blurb: CATEGORY_META[name]?.blurb || `${count} programs in this category.`,
    icon: CATEGORY_META[name]?.icon || DEFAULT_ICON,
  }));

// Pill color map
const pillColorMap: Record<string, string> = {
  amber: 'bg-amber-500',
  blue: 'bg-blue-500',
  emerald: 'bg-emerald-500',
  purple: 'bg-purple-500',
  red: 'bg-red-500',
};
---

<SiteLayout title="Home">
  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section id="hero-section" class="hero">
    <div class="ds-shell hero__inner">
      <p class="ds-eyebrow">Nine counties · {totalPrograms.toLocaleString()} programs</p>
      <h1>Find help with food, housing, health care and bills</h1>
      <p class="ds-lede">
        Free and low-cost programs across the San Francisco Bay Area. No account, no tracking,
        nothing to pay.
      </p>

      <!-- Search. These ids are the contract home-search.js binds to. -->
      <div class="search-panel" role="search">
        <div class="ds-field search-panel__what">
          <label class="ds-label" for="search-input">What do you need?</label>
          <input
            id="search-input"
            type="search"
            class="ds-input"
            placeholder="Food bank, rent help, free clinic…"
            autocomplete="off"
            enterkeyhint="search"
          />
        </div>

        <div class="ds-field search-panel__where">
          <label class="ds-label" for="location-input">Where are you?</label>
          <div class="search-panel__where-row">
            <input
              id="location-input"
              type="text"
              class="ds-input"
              placeholder="City or ZIP"
              autocomplete="postal-code"
              enterkeyhint="search"
            />
            <button
              id="detect-location-btn"
              type="button"
              class="ds-btn ds-btn--secondary search-panel__detect"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 2v3m0 14v3M2 12h3m14 0h3" stroke-linecap="round"></path>
              </svg>
              <span class="search-panel__detect-text">Use my location</span>
            </button>
          </div>
        </div>

        <button
          id="search-submit-btn"
          type="button"
          class="ds-btn ds-btn--primary search-panel__go"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            aria-hidden="true"
          >
            <circle cx="9" cy="9" r="5.5"></circle>
            <path d="M13.2 13.2l3.3 3.3" stroke-linecap="round"></path>
          </svg>
          Search
        </button>
      </div>

      {
        pills.length > 0 && (
          <ul class="hero__pills" aria-label="Timely updates">
            {pills.map((pill) => (
              <li>
                <a href={pill.href} class="ds-pill">
                  <strong>{pill.label}</strong>
                  <span class="hero__pill-detail">{pill.detail}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- ── Crisis ───────────────────────────────────────────────────────────── -->
  <section class="crisis" aria-labelledby="crisis-heading">
    <div class="ds-shell crisis__inner">
      <h2 id="crisis-heading" class="crisis__title">Need help right now?</h2>
      <ul class="crisis__list">
        <li>
          <a href="tel:911" class="ds-btn ds-btn--danger"
            ><strong>911</strong><span>Emergency</span></a
          >
        </li>
        <li>
          <a href="tel:988" class="ds-btn ds-btn--secondary"
            ><strong>988</strong><span>Suicide &amp; crisis</span></a
          >
        </li>
        <li>
          <a href="tel:211" class="ds-btn ds-btn--secondary"
            ><strong>211</strong><span>Local helpline</span></a
          >
        </li>
      </ul>
    </div>
  </section>

  <!-- ── Categories ───────────────────────────────────────────────────────── -->
  <section class="ds-section" aria-labelledby="cat-heading">
    <div class="ds-shell ds-stack">
      <div class="section-head">
        <h2 id="cat-heading">Browse by category</h2>
        <a class="section-head__link" href="/directory"
          >All {totalPrograms.toLocaleString()} programs</a
        >
      </div>
      <ul class="ds-grid card-list">
        {
          categories.map((cat) => (
            <li class="ds-card ds-card--link">
              <span class="tile-icon" aria-hidden="true">
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  set:html={cat.icon}
                />
              </span>
              <h3 class="ds-card__title">
                <a class="ds-card__link" href={cat.href}>
                  {cat.name}
                </a>
              </h3>
              <p class="ds-card__body">{cat.blurb}</p>
              <p class="ds-card__meta">{cat.count} programs</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Live ─────────────────────────────────────────────────────────────── -->
  <section class="ds-section" aria-labelledby="live-heading">
    <div class="ds-shell ds-stack">
      <div class="section-head"><h2 id="live-heading">Live right now</h2></div>
      <ul class="ds-grid card-list">
        <li class="ds-card ds-card--link">
          <span class="tile-icon" aria-hidden="true">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              set:html={icons.transit}
            />
          </span>
          <h3 class="ds-card__title"><a class="ds-card__link" href="/transit">Transit</a></h3>
          <p class="ds-card__body">
            Real-time status for BART, Muni, Caltrain and every Bay Area system, plus Clipper
            discounts.
          </p>
        </li>
        <li class="ds-card ds-card--link">
          <span class="tile-icon" aria-hidden="true">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              set:html={icons.airplane}
            />
          </span>
          <h3 class="ds-card__title"><a class="ds-card__link" href="/airports">Airports</a></h3>
          <p class="ds-card__body">
            SFO, OAK and SJC — terminals, ground transport, parking and flight status.
          </p>
        </li>
        <li class="ds-card ds-card--link">
          <span class="tile-icon" aria-hidden="true">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              set:html={icons.alerts}
            />
          </span>
          <h3 class="ds-card__title"><a class="ds-card__link" href="/alerts">Alerts</a></h3>
          <p class="ds-card__body">
            Missing persons, community safety and emergency alerts across the nine counties.
          </p>
          <div id="home-alerts-cases" class="tile-cases"></div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ── Eligibility ──────────────────────────────────────────────────────── -->
  <section class="ds-section" aria-labelledby="elig-heading">
    <div class="ds-shell">
      <div class="promo">
        <div>
          <h2 id="elig-heading" class="promo__title">Not sure what you qualify for?</h2>
          <p class="ds-lede">
            Answer a few questions and we will show what you are likely eligible for. About two
            minutes, and nothing you enter leaves your device.
          </p>
        </div>
        <a href="/eligibility" class="ds-btn ds-btn--primary promo__cta">Check eligibility</a>
      </div>

      {
        groups.length > 0 && (
          <ul class="group-pills" aria-label="Browse by who you are">
            {groups.slice(0, 8).map((g) => (
              <li>
                <a class="ds-pill" href={`/directory?group=${encodeURIComponent(g.id || g.name)}`}>
                  {g.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <div
    id="home-search-config"
    hidden
    data-synonyms={JSON.stringify(searchConfig.synonyms || {})}
    data-best-bets={JSON.stringify(searchConfig.best_bets || {})}
    data-query-rewrites={JSON.stringify(searchConfig.query_rewrites || {})}
    data-zip-to-city={JSON.stringify(homeZipToCity)}
    data-city-to-county={JSON.stringify(homeCityToCounty)}
    data-total-programs={String(totalPrograms)}
  >
  </div>

  <script is:inline src="/assets/js/home-search.js"></script>

  <script>
    import { makeSearchFn } from '@/lib/search-client';
    import { resolveLocationInput, buildCountiesFilter } from '@/lib/location';

    const cfg = document.getElementById('home-search-config');
    if (cfg && window.HomeSearch) {
      const searchConfig = {
        synonyms: JSON.parse(cfg.dataset.synonyms || '{}'),
        best_bets: JSON.parse(cfg.dataset.bestBets || '{}'),
        query_rewrites: JSON.parse(cfg.dataset.queryRewrites || '{}'),
      };
      const cityToCounty = JSON.parse(cfg.dataset.cityToCounty || '{}');

      window.HomeSearch.init({
        synonyms: searchConfig.synonyms,
        bestBets: searchConfig.best_bets,
        queryRewrites: searchConfig.query_rewrites,
        zipToCity: JSON.parse(cfg.dataset.zipToCity || '{}'),
        cityToCounty,
        totalPrograms: cfg.dataset.totalPrograms || '0',
        searchFn: makeSearchFn('/data/search-index.json', searchConfig, cityToCounty),
        resolveLocationFn: resolveLocationInput,
        buildCountiesFilterFn: buildCountiesFilter,
      });
    }
  </script>

  <style>
    /* Composition only — colour, type and spacing come from the design tokens,
       so this page cannot drift out of AAA on its own. */
    .hero {
      background:
        radial-gradient(110% 130% at 8% 0%, var(--ds-brand-soft) 0%, transparent 62%), var(--ds-bg);
      padding-block: var(--ds-gap-xl) var(--ds-gap-lg);
    }
    .hero__inner {
      display: flex;
      flex-direction: column;
      gap: var(--ds-gap-md);
      max-width: 56rem;
    }
    .hero h1 {
      margin: 0;
    }
    .hero__pills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--ds-gap-xs);
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .hero__pill-detail {
      color: var(--ds-text-muted);
      font-weight: 500;
    }

    .search-panel {
      display: grid;
      gap: var(--ds-gap);
      grid-template-columns: 1fr;
      padding: var(--ds-gap-md);
      background: var(--ds-surface-raised);
      border: 1px solid var(--ds-border-soft);
      border-radius: var(--ds-radius-lg);
      box-shadow: var(--ds-shadow);
    }
    @media (min-width: 56rem) {
      .search-panel {
        grid-template-columns: 1.5fr 1fr auto;
        align-items: end;
      }
    }
    .search-panel__where-row {
      display: flex;
      gap: var(--ds-gap-xs);
    }
    .search-panel__where-row .ds-input {
      flex: 1 1 auto;
      min-width: 0;
    }
    .search-panel__detect {
      flex: 0 0 auto;
      padding-inline: 0.75rem;
    }
    @media (min-width: 56rem) and (max-width: 74rem) {
      .search-panel__detect-text {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    }

    .crisis {
      padding-block: var(--ds-gap-lg);
    }
    .crisis__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
