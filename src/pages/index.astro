---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import LiveCard from '../components/LiveCard.astro';
import CrisisBar from '../components/CrisisBar.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';

// --- Load custom theme (sports/patriotic/special events) ---
const customThemeFile = path.join(process.cwd(), 'src/data/custom-themes.yml');
let activeTeamTheme: any = null;

if (fs.existsSync(customThemeFile)) {
  const themeData = yaml.load(fs.readFileSync(customThemeFile, 'utf8')) as any;
  const today = new Date().toISOString().split('T')[0];
  let activeThemeId = themeData.activeTheme;

  if (themeData.schedule && Array.isArray(themeData.schedule)) {
    for (const scheduled of themeData.schedule) {
      if (scheduled.start <= today && today <= scheduled.end) {
        activeThemeId = scheduled.team;
        break;
      }
    }
  }

  if (!activeThemeId || activeThemeId === 'default') {
    const sportsDataPath = path.join(process.cwd(), 'public', 'data', 'sports-data.json');
    if (fs.existsSync(sportsDataPath)) {
      try {
        const sportsData = JSON.parse(fs.readFileSync(sportsDataPath, 'utf8'));
        const priorityOrder = ['championship', 'playoffs', 'streak', 'hot'];
        let bestTeam: string | null = null;
        let bestPriority = priorityOrder.length;
        for (const [, team] of Object.entries(sportsData.teams || {}) as [string, any][]) {
          if (team.excitement) {
            const priority = priorityOrder.indexOf(team.excitement);
            if (priority !== -1 && priority < bestPriority) {
              bestPriority = priority;
              bestTeam = team.themeId;
            }
          }
        }
        if (bestTeam) activeThemeId = bestTeam;
      } catch {
        // Sports data unavailable
      }
    }
  }

  if (activeThemeId && activeThemeId !== 'default') {
    const themeSource = themeData.teams?.[activeThemeId] || themeData.special?.[activeThemeId];
    if (themeSource) activeTeamTheme = { id: activeThemeId, ...themeSource };
  }
}

// --- Load all programs and count by category ---
const dataDir = path.join(process.cwd(), 'src/data');
const NON_PROGRAM_FILES = [
  'cities.yml',
  'groups.yml',
  'zipcodes.yml',
  'suppressed.yml',
  'search-config.yml',
  'transit-agencies.yml',
  'county-supervisors.yml',
  'site-config.yml',
  'bay-area-jurisdictions.yml',
  'city-profiles.yml',
  'helplines.yml',
  'custom-themes.yml',
  'chat-messages.yml',
  'homepage-pills.yml',
];

const suppressedFile = path.join(dataDir, 'suppressed.yml');
let suppressedIds = new Set<string>();
if (fs.existsSync(suppressedFile)) {
  const suppressedData = yaml.load(fs.readFileSync(suppressedFile, 'utf8')) as any[];
  if (Array.isArray(suppressedData)) {
    suppressedIds = new Set(suppressedData.map((s) => s.id));
  }
}

const categoryCounts: Record<string, number> = {};
let totalPrograms = 0;
const files = fs
  .readdirSync(dataDir)
  .filter((f) => f.endsWith('.yml') && !NON_PROGRAM_FILES.includes(f));

for (const file of files) {
  const content = fs.readFileSync(path.join(dataDir, file), 'utf8');
  const data = yaml.load(content) as any;
  if (!data) continue;
  const programs = Array.isArray(data) ? data : data.programs || [];
  for (const program of programs) {
    const category =
      program.category ||
      file
        .replace('.yml', '')
        .replace(/-/g, ' ')
        .replace(/\b\w/g, (c: string) => c.toUpperCase());
    const id =
      program.id ||
      `${category.toLowerCase().replace(/\s+/g, '-')}-${(program.name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
    if (!suppressedIds.has(id)) {
      categoryCounts[category] = (categoryCounts[category] || 0) + 1;
      totalPrograms++;
    }
  }
}

// --- Load contextual pills ---
const pillsFile = path.join(dataDir, 'homepage-pills.yml');
let pills: Array<{ label: string; detail: string; href: string; color: string; active: boolean }> =
  [];
try {
  const pillsData = yaml.load(fs.readFileSync(pillsFile, 'utf8')) as any;
  pills = (pillsData?.pills || []).filter((p: any) => p.active !== false);
} catch {
  // Pills unavailable
}

// --- Load groups for eligibility card ---
const groupsFile = path.join(dataDir, 'groups.yml');
let groups: any[] = [];
try {
  const groupsData = yaml.load(fs.readFileSync(groupsFile, 'utf8')) as any;
  groups = groupsData?.groups || [];
} catch {}

// --- Load search config ---
let searchConfig = { synonyms: {}, best_bets: {}, suggestions: [], query_rewrites: {} };
try {
  const searchConfigPath = path.join(process.cwd(), 'src/data/search-config.yml');
  searchConfig = yaml.load(fs.readFileSync(searchConfigPath, 'utf8')) as typeof searchConfig;
} catch {}

// --- Load location data ---
let homeZipToCity: Record<string, string> = {};
let homeCityToCounty: Record<string, string> = {};
try {
  const citiesData = yaml.load(fs.readFileSync(path.join(dataDir, 'cities.yml'), 'utf8')) as Array<{
    name: string;
    county: string;
  }>;
  for (const city of citiesData) homeCityToCounty[city.name.toLowerCase()] = city.county;
  const zipData = yaml.load(fs.readFileSync(path.join(dataDir, 'zipcodes.yml'), 'utf8')) as Record<
    string,
    string
  >;
  homeZipToCity = Object.fromEntries(
    Object.entries(zipData).map(([zip, city]) => [String(zip), city])
  );
} catch {}

// --- Category counts ---
const foodCount = categoryCounts['Food'] || 0;
const utilityCount = categoryCounts['Utilities'] || 0;
const housingCount = categoryCounts['Housing'] || 0;
const healthCount = categoryCounts['Health'] || 0;
const jobsCount = categoryCounts['Employment'] || 0;
const legalCount = categoryCounts['Legal Services'] || 0;
const transitCount = categoryCounts['Transportation'] || 0;
const educationCount = categoryCounts['Education'] || 0;

// --- SVG icon paths (reusable) ---
const icons = {
  food: '<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>',
  housing:
    '<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>',
  health:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>',
  utilities:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/>',
  jobs: '<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z"/>',
  transit:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>',
  alerts:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>',
  eligibility:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>',
  airplane:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"/>',
};

// Pill color map
const pillColorMap: Record<string, string> = {
  amber: 'bg-amber-500',
  blue: 'bg-blue-500',
  emerald: 'bg-emerald-500',
  purple: 'bg-purple-500',
  red: 'bg-red-500',
};
---

<BaseLayout
  title="Home"
  description="Find free and low-cost programs for food, housing, healthcare, utilities, and more across the San Francisco Bay Area."
>
  <main id="home-main-content" class="home-page max-w-5xl mx-auto px-4 pb-8">
    <!-- ═══════════════════════════════════════════ -->
    <!-- HERO: Search + program count              -->
    <!-- ═══════════════════════════════════════════ -->
    <section
      id="hero-section"
      class="home-hero relative pt-10 pb-5 mt-2 rounded-2xl overflow-hidden"
      aria-labelledby="search-heading"
    >
      <div class="relative z-10">
        <h1
          id="search-heading"
          class="font-display text-3xl sm:text-4xl font-semibold text-primary-900 dark:text-white mb-2 tracking-tight text-center text-balance leading-tight"
          data-i18n="home.heroTitle"
        >
          Find programs, services, and resources in the Bay Area
        </h1>
        <p
          class="text-neutral-500 dark:text-neutral-300 text-sm sm:text-base mb-6 text-center max-w-2xl mx-auto"
          data-i18n="home.heroSubtitle"
        >
          Free and low-cost resources for food, housing, healthcare, utilities, and more.
        </p>

        <!-- Unified search bar -->
        <div class="home-search-shell search-bar max-w-2xl mx-auto">
          <div class="search-bar-field">
            <span class="search-bar-field-label">What</span>
            <label for="search-input" class="sr-only">Search programs and services</label>
            <svg
              class="search-bar-field-icon"
              fill="none"
              viewBox="0 0 20 20"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 3.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11Zm4.2 9.7l3.3 3.3"></path>
            </svg>
            <input
              id="search-input"
              type="search"
              class="search-bar-input"
              placeholder='Try: "food banks near me" or "help paying my electric bill"'
              autocomplete="off"
              aria-label="Search programs and services"
            />
            <span
              id="carl-badge"
              class="hidden items-center gap-1.5 text-xs text-accent-800 dark:text-accent-300 bg-accent-50 dark:bg-accent-900/40 px-2.5 py-1 rounded-lg font-medium whitespace-nowrap"
              aria-hidden="true"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"
                ></path>
              </svg>
              Carl
            </span>
          </div>

          <div class="search-bar-divider" aria-hidden="true"></div>
          <div class="search-bar-divider-mobile" aria-hidden="true"></div>

          <div class="search-bar-field sm:max-w-[14rem]">
            <span class="search-bar-field-label">Where</span>
            <svg
              class="search-bar-field-icon"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0115 0z"
              ></path>
            </svg>
            <input
              id="location-input"
              type="text"
              class="search-bar-input text-sm"
              placeholder="City or ZIP"
              autocomplete="off"
              aria-label="City or ZIP code"
            />
          </div>

          <button id="search-submit-btn" class="search-bar-cta" aria-label="Search">
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 20 20"
              stroke="currentColor"
              stroke-width="1.9"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 3.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11Zm4.2 9.7l3.3 3.3"></path>
            </svg>
            <span class="hidden sm:inline">Search</span>
          </button>
        </div>

        <p class="text-center text-sm text-neutral-500 dark:text-neutral-300 mt-3">
          <span class="font-semibold text-primary-700 dark:text-primary-400">{totalPrograms}+</span>
          <span data-i18n="home.programsFound">programs found</span>
        </p>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- CONTEXTUAL PILLS — data-driven            -->
    <!-- ═══════════════════════════════════════════ -->
    {
      pills.length > 0 && (
        <div
          class="flex gap-2.5 overflow-x-auto scrollbar-hide py-3 mt-2"
          role="region"
          aria-label="Current alerts and events"
        >
          {pills.map((pill) => (
            <a
              href={pill.href}
              class="flex-shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-full bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200 text-sm hover:bg-neutral-100 dark:hover:bg-neutral-700 transition-colors no-underline"
            >
              <span
                class:list={[
                  'w-2 h-2 rounded-full flex-shrink-0',
                  pillColorMap[pill.color] || 'bg-blue-500',
                ]}
                aria-hidden="true"
              />
              <span class="font-medium">{pill.label}</span>
              <span class="text-neutral-600 dark:text-neutral-300">{pill.detail}</span>
            </a>
          ))}
        </div>
      )
    }

    <!-- ═══════════════════════════════════════════ -->
    <!-- CRISIS BAR                                -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="my-4">
      <CrisisBar />
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- CATEGORY CARDS — direct links, no expand  -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="py-4" aria-labelledby="situations-heading">
      <h2
        id="situations-heading"
        class="font-display text-xl font-semibold text-neutral-800 dark:text-neutral-200 mb-4"
        data-i18n="home.browseByCategory"
      >
        I need help with&hellip;
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <CategoryCard
          title="Food & Groceries"
          subtitle="Food banks, CalFresh, meals"
          count={foodCount}
          href="/directory?category=Food"
          color="red"
          icon={icons.food}
          tip="Most people are approved for CalFresh in 3 days"
          tipHref="https://www.getcalfresh.org"
          i18nKey="categories.food"
        />
        <CategoryCard
          title="Housing & Shelter"
          subtitle="Shelters, rent help, housing"
          count={housingCount}
          href="/directory?category=Housing"
          color="primary"
          icon={icons.housing}
          tip="Facing eviction? Eviction Defense Collaborative:"
          tipPhone="415-947-0797"
          i18nKey="categories.housing"
        />
        <CategoryCard
          title="Health & Medical"
          subtitle="Medi-Cal, clinics, mental health"
          count={healthCount}
          href="/directory?category=Health"
          color="rose"
          icon={icons.health}
          tip="Apply for Medi-Cal"
          tipHref="https://www.coveredca.com"
          i18nKey="categories.health"
        />
        <CategoryCard
          title="Bills & Utilities"
          subtitle="CARE, FERA, bill assistance"
          count={utilityCount}
          href="/directory?category=Utilities"
          color="amber"
          icon={icons.utilities}
          tip="Behind on PG&E? Apply for CARE/FERA"
          tipHref="https://www.pge.com/care"
          i18nKey="categories.utilities"
        />
        <CategoryCard
          title="Jobs & Employment"
          subtitle="Job search, training, unemployment"
          count={jobsCount}
          href="/directory?category=Employment"
          color="indigo"
          icon={icons.jobs}
          tip="File for unemployment"
          tipHref="https://edd.ca.gov"
          i18nKey="categories.employment"
        />
        <CategoryCard
          title="Legal Services"
          subtitle="Legal aid, immigration, tenant rights"
          count={legalCount}
          href="/directory?category=Legal%20Services"
          color="indigo"
          icon={icons.jobs}
          tip="Free legal help — Bay Area Legal Aid:"
          tipPhone="1-800-551-5554"
          i18nKey="categories.legal"
        />
      </div>

      <div class="flex flex-wrap gap-2 mt-4">
        <a
          href="/transit"
          class="text-xs text-primary-700 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-200 bg-primary-50 dark:bg-primary-900/30 px-3 py-1.5 rounded-full no-underline transition-colors"
          >Transportation ({transitCount})</a
        >
        <a
          href="/directory?category=Education"
          class="text-xs text-primary-700 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-200 bg-primary-50 dark:bg-primary-900/30 px-3 py-1.5 rounded-full no-underline transition-colors"
          >Education ({educationCount})</a
        >
        <a
          href="/directory"
          class="text-xs text-neutral-600 dark:text-neutral-300 hover:text-primary-700 dark:hover:text-primary-300 px-3 py-1.5 rounded-full no-underline transition-colors"
          data-i18n="home.viewAllDirectory">View all {totalPrograms} programs →</a
        >
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- BAY AREA LIVE — 3 focused cards           -->
    <!-- ═══════════════════════════════════════════ -->
    <section
      class="py-6 border-t border-neutral-200 dark:border-neutral-700"
      aria-labelledby="live-heading"
    >
      <h2
        id="live-heading"
        class="text-lg font-semibold text-neutral-800 dark:text-neutral-200 mb-3"
      >
        Bay Area Live
      </h2>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <LiveCard
          title="Transit"
          href="/transit"
          icon={icons.transit}
          iconColor="blue"
          description="Real-time status for BART, Muni, Caltrain, and all Bay Area systems."
          footer="Clipper discounts · Paratransit · Free ride programs"
        />
        <LiveCard
          title="Airports"
          href="/airports"
          icon={icons.airplane}
          iconColor="orange"
          description="SFO, OAK, SJC — terminals, parking, and real-time flight status."
          footer="Ground transport · Terminal maps"
        />
        <LiveCard
          id="home-alerts-card"
          title="Alerts"
          href="/alerts"
          icon={icons.alerts}
          iconColor="red"
          description="Missing persons, community safety, and emergency alerts."
          footer="View all alerts · 1-800-THE-LOST"
        >
          <div id="home-alerts-cases" class="mt-2 space-y-1.5"></div>
        </LiveCard>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- ELIGIBILITY + EXPLORE — secondary row     -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="pb-6" aria-label="More tools">
      <div class="grid gap-3 sm:grid-cols-2">
        <a
          href="/eligibility"
          class="group block rounded-xl border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 p-4 hover:border-primary-300 dark:hover:border-primary-600 hover:shadow-sm transition-all no-underline focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500"
        >
          <div class="flex items-center gap-2 mb-2">
            <div
              class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center"
              aria-hidden="true"
            >
              <svg
                class="w-5 h-5 text-emerald-600 dark:text-emerald-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <Fragment set:html={icons.eligibility} />
              </svg>
            </div>
            <span
              class="font-medium text-sm text-neutral-900 dark:text-white group-hover:text-primary-700 dark:group-hover:text-primary-300 transition-colors"
              >Eligibility Guide</span
            >
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-300">
            Answer a few quick questions to find programs you may qualify for — takes 2 minutes, no
            personal info stored.
          </p>
          {
            groups.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-2">
                {groups.slice(0, 4).map((g) => (
                  <span class="text-xs bg-neutral-100 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300 px-2 py-0.5 rounded-full">
                    {g.name}
                  </span>
                ))}
                {groups.length > 4 && (
                  <span class="text-xs bg-neutral-100 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300 px-2 py-0.5 rounded-full">
                    +{groups.length - 4} more
                  </span>
                )}
              </div>
            )
          }
        </a>

        <a
          href="/directory"
          class="group block rounded-xl border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 p-4 hover:border-primary-300 dark:hover:border-primary-600 hover:shadow-sm transition-all no-underline focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500"
        >
          <div class="flex items-center gap-2 mb-2">
            <div
              class="w-8 h-8 rounded-lg bg-violet-100 dark:bg-violet-900/40 flex items-center justify-center"
              aria-hidden="true"
            >
              <svg
                class="w-5 h-5 text-violet-600 dark:text-violet-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"
                ></path>
              </svg>
            </div>
            <span
              class="font-medium text-sm text-neutral-900 dark:text-white group-hover:text-primary-700 dark:group-hover:text-primary-300 transition-colors"
              >Explore All Resources</span
            >
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-300">
            {totalPrograms} programs, open data, municipal codes & interactive Bay Area map.
          </p>
        </a>
      </div>
    </section>
  </main>

  <!-- Runtime config for search module -->
  <div
    id="home-search-config"
    data-total-programs={String(totalPrograms)}
    data-synonyms={JSON.stringify(searchConfig.synonyms || {})}
    data-best-bets={JSON.stringify(searchConfig.best_bets || {})}
    data-query-rewrites={JSON.stringify(searchConfig.query_rewrites || {})}
    data-zip-to-city={JSON.stringify(homeZipToCity)}
    data-city-to-county={JSON.stringify(homeCityToCounty)}
    class="hidden"
  >
  </div>

  <!-- Home search module (extracted) -->
  <script is:inline src="/assets/js/home-search.js"></script>

  <!-- Initialize search with shared lib -->
  <script>
    import { makeSearchFn } from '@/lib/search-client';
    import { resolveLocationInput, buildCountiesFilter } from '@/lib/location';

    const cfg = document.getElementById('home-search-config');
    if (cfg && window.HomeSearch) {
      const searchConfig = {
        synonyms: JSON.parse(cfg.dataset.synonyms || '{}'),
        best_bets: JSON.parse(cfg.dataset.bestBets || '{}'),
        query_rewrites: JSON.parse(cfg.dataset.queryRewrites || '{}'),
      };
      const cityToCounty = JSON.parse(cfg.dataset.cityToCounty || '{}');

      window.HomeSearch.init({
        synonyms: searchConfig.synonyms,
        bestBets: searchConfig.best_bets,
        queryRewrites: searchConfig.query_rewrites,
        zipToCity: JSON.parse(cfg.dataset.zipToCity || '{}'),
        cityToCounty,
        totalPrograms: cfg.dataset.totalPrograms || '0',

        // Client-side search over the static index. No server in this path, so
        // homepage search can no longer be taken down by the Meilisearch host.
        searchFn: makeSearchFn('/data/search-index.json', searchConfig, cityToCounty),

        // rewriteQueryFn / expandSynonymsFn / getBestBetsFn are deliberately
        // NOT passed: search-core does all three internally against the same
        // config, and pre-processing the query here would double-apply them.
        resolveLocationFn: resolveLocationInput,
        buildCountiesFilterFn: buildCountiesFilter,
      });
    }
  </script>

  <!-- Alerts card runtime loader -->
  <script>
    (async function () {
      const container = document.getElementById('home-alerts-cases');
      if (!container) return;

      try {
        const resp = await fetch(
          'https://baytidesstorage.blob.core.windows.net/missing-persons/missing-persons.json',
          { signal: AbortSignal.timeout(5000) }
        );
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data = await resp.json();
        const cases = (data.cases || []).slice(0, 2);

        if (cases.length === 0) return;

        for (const c of cases) {
          const row = document.createElement('div');
          row.className = 'flex items-center gap-2 text-xs';

          const name = document.createElement('span');
          name.className = 'font-medium text-neutral-900 dark:text-white truncate';
          name.textContent = c.name + (c.age ? `, ${c.age}` : '');
          row.appendChild(name);

          const meta = document.createElement('span');
          meta.className = 'text-neutral-500 dark:text-neutral-300';
          meta.textContent = c.missingFrom?.city || '';
          row.appendChild(meta);

          container.appendChild(row);
        }
      } catch {
        // Alerts unavailable — card still links to /alerts
      }
    })();
  </script>

  <style>
    .home-hero {
      border: 1px solid var(--home-border-light, rgba(170, 196, 212, 0.55));
      background:
        radial-gradient(
          circle at 84% 14%,
          color-mix(in srgb, var(--theme-accent-color) 20%, transparent),
          transparent 42%
        ),
        linear-gradient(
          148deg,
          color-mix(in srgb, var(--theme-gradient-from) 10%, #ffffff) 0%,
          #f7fafc 54%,
          color-mix(in srgb, var(--theme-gradient-to) 8%, #f4f8fb) 100%
        );
      box-shadow: 0 10px 24px rgba(15, 23, 32, 0.08);
      padding: 2rem 1.25rem 1.25rem;
    }

    :global(.dark) .home-hero {
      --home-border-light: rgba(86, 106, 124, 0.65);
      border-color: var(--home-border-light);
      background:
        radial-gradient(
          circle at 84% 14%,
          color-mix(in srgb, var(--theme-accent-color) 20%, transparent),
          transparent 44%
        ),
        linear-gradient(
          148deg,
          color-mix(in srgb, var(--theme-gradient-from) 14%, #121a24) 0%,
          #101823 56%,
          color-mix(in srgb, var(--theme-gradient-to) 12%, #0d141d) 100%
        );
      box-shadow: none;
    }

    .home-search-shell {
      border-color: rgba(170, 196, 212, 0.55);
      background: rgba(255, 255, 255, 0.96);
    }

    :global(.dark) .home-search-shell {
      border-color: rgba(86, 106, 124, 0.65);
      background: rgba(14, 22, 33, 0.95);
    }

    #search-submit-btn {
      background: linear-gradient(
        135deg,
        var(--theme-gradient-from) 0%,
        var(--theme-gradient-to) 100%
      );
    }
    #search-submit-btn:hover {
      filter: brightness(0.95);
    }

    /* Category card hover */
    :global(.category-card) {
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
    }
    :global(.category-card:hover) {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(15, 23, 32, 0.08);
    }
    :global(.category-card) svg {
      transition: transform 0.2s cubic-bezier(0.32, 0.72, 0, 1);
    }
    :global(.category-card:hover) svg {
      transform: scale(1.08);
    }

    /* Scrollbar hide */
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      :global(.category-card:hover) {
        transform: none;
      }
      :global(.category-card) svg {
        transition: none !important;
      }
      :global(.category-card:hover) svg {
        transform: none !important;
      }
    }

    /* High-contrast */
    @media (forced-colors: active) {
      .home-hero,
      :global(.category-card) {
        border: 2px solid ButtonText;
      }
    }
  </style>
</BaseLayout>
