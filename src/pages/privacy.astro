          <script is:inline src="/assets/js/carl-storage.js"></script>
          <script is:inline>
            // Carl Privacy Controls
            document.addEventListener('DOMContentLoaded', async () => {
              const toggle = document.getElementById('carl-history-toggle');
              const actionsPanel = document.getElementById('carl-history-actions');
              const countEl = document.getElementById('carl-history-count');
              const exportBtn = document.getElementById('carl-export-btn');
              const clearBtn = document.getElementById('carl-clear-btn');

              if (!toggle || typeof window.CarlStorage === 'undefined') return;

              // Initialize toggle state
              const enabled = await window.CarlStorage.isHistoryEnabled();
              toggle.checked = enabled;
              if (enabled) {
                actionsPanel?.classList.remove('hidden');
                updateCount();
              }

              // Toggle handler
              toggle.addEventListener('change', async () => {
                const newState = toggle.checked;
                await window.CarlStorage.setHistoryEnabled(newState);

                if (newState) {
                  actionsPanel?.classList.remove('hidden');
                  updateCount();
                } else {
                  actionsPanel?.classList.add('hidden');
                }
              });

              // Update conversation count
              async function updateCount() {
                if (countEl) {
                  const count = await window.CarlStorage.getConversationCount();
                  countEl.textContent = count.toString();
                }
              }

              // Export handler
              exportBtn?.addEventListener('click', async () => {
                const data = await window.CarlStorage.exportData();
                const blob = new Blob([JSON.stringify(data, null, 2)], {
                  type: 'application/json',
                });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `carl-history-${new Date().toISOString().split('T')[0]}.json`;
                a.click();
                URL.revokeObjectURL(url);
              });

              // Clear handler
              clearBtn?.addEventListener('click', async () => {
                if (confirm('Clear all conversation history? This cannot be undone.')) {
                  await window.CarlStorage.clearAllHistory();
                  updateCount();
                }
              });

              // Listen for history changes from other tabs/components
              document.addEventListener('carlHistoryCleared', updateCount);
            });
          </script>

