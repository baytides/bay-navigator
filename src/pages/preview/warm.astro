---
/**
 * Design direction 2 of 3 — "Warm & human".
 *
 * Premise: the clinical-portal look tells people this is a bureaucracy that will
 * probably say no. This direction reads like a neighbour who knows where things
 * are: warm paper-coloured ground, serif display type, real voice in the copy,
 * generous rounded shapes. Same information, different posture.
 */
import { loadStats } from '../../lib/program-stats';
const { total, categories } = loadStats();
const featured = categories.slice(0, 6);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Warm direction · Bay Navigator</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>

    <div class="banner">
      Design preview 2 of 3 — <strong>Warm &amp; human</strong> ·
      <a href="/preview/utility">Utility</a> · <a href="/preview/dense">Dense</a>
    </div>

    <header>
      <div class="wrap row">
        <a class="brand" href="/">
          <img src="/assets/images/logo/logo.webp" alt="" width="40" height="40" />
          <span>Bay Navigator</span>
        </a>
        <nav aria-label="Primary">
          <a href="/directory">Find help</a>
          <a href="/eligibility">Check eligibility</a>
          <a href="/about">About us</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="wrap hero__grid">
          <div>
            <h1>You don't have to figure this out alone.</h1>
            <p class="lede">
              {total.toLocaleString()} free and low-cost programs across the nine Bay Area counties —
              food, a place to sleep, seeing a doctor, keeping the lights on. We keep the list. You keep
              your privacy.
            </p>

            <form class="search" action="/directory" method="get" role="search">
              <label class="sr" for="q">What do you need help with?</label>
              <input
                id="q"
                name="q"
                type="search"
                placeholder="What do you need help with?"
                autocomplete="off"
                enterkeyhint="search"
              />
              <button type="submit">Find help</button>
            </form>
            <p class="reassure">
              No account. No cost. We don't track you or share anything you type.
            </p>
          </div>

          <div class="hero__art" aria-hidden="true">
            <svg viewBox="0 0 220 220" role="presentation">
              <circle cx="110" cy="110" r="104" fill="#e9dcc9"></circle>
              <path d="M18 150c34-16 54 10 92-6s58 6 92-12v88H18z" fill="#1f5540" opacity=".9"
              ></path>
              <path
                d="M30 150c30-42 62-12 84-44s52-6 76-28"
                stroke="#b0613a"
                stroke-width="7"
                fill="none"
                stroke-linecap="round"></path>
              <circle cx="158" cy="62" r="20" fill="#e2a33f"></circle>
            </svg>
          </div>
        </div>
      </section>

      <section class="wrap band" aria-labelledby="urgent-h">
        <div class="urgent">
          <h2 id="urgent-h">Need someone right now?</h2>
          <p>These are free, 24 hours a day, and you can call from any phone.</p>
          <div class="urgent__row">
            <a href="tel:988"><strong>988</strong><span>Talk to someone</span></a>
            <a href="tel:211"><strong>211</strong><span>Find local help</span></a>
            <a href="tel:911"><strong>911</strong><span>Emergency</span></a>
          </div>
        </div>
      </section>

      <section class="wrap band" aria-labelledby="browse-h">
        <h2 id="browse-h">Where would you like to start?</h2>
        <ul class="cards">
          {
            featured.map((c) => (
              <li>
                <a href={`/directory?category=${encodeURIComponent(c.slug)}`}>
                  <h3>{c.name}</h3>
                  <p>{c.count} programs</p>
                  <span class="go">Have a look →</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="more">
          <a href="/directory"
            >Or see everything we have — all {total.toLocaleString()} programs →</a
          >
        </p>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <p class="foot-lede">
          Bay Navigator is kept up by people who live here. It's free, open source, and there are no
          ads.
        </p>
        <nav aria-label="Footer">
          <a href="/about">About</a>
          <a href="/accessibility">Accessibility</a>
          <a href="/privacy">Privacy</a>
          <a href="/feedback">Tell us something's wrong</a>
        </nav>
      </div>
    </footer>

    <style is:global>
      /* Palette verified: 15.9:1 body, 10.1:1 links, 8.6:1 buttons (AAA + APCA). */
      :root {
        --bg: #fdf8f3;
        --paper: #ffffff;
        --surface: #f6ede2;
        --text: #241c16;
        --muted: #4a3b30;
        --accent: #1f5540;
        --accent-text: #1a4636;
        --clay: #a8492a;
        --border: #8a7461;
        --on-accent: #ffffff;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font:
          400 1.0625rem/1.65 ui-sans-serif,
          system-ui,
          -apple-system,
          'Segoe UI',
          Arial,
          sans-serif;
      }
      .wrap {
        width: 100%;
        max-width: 68rem;
        margin-inline: auto;
        padding-inline: 1.5rem;
      }
      .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }
      .skip {
        position: absolute;
        left: 1rem;
        top: -4rem;
        background: var(--accent);
        color: var(--on-accent);
        padding: 0.75rem 1.25rem;
        border-radius: 0 0 12px 12px;
        font-weight: 700;
        z-index: 10;
      }
      .skip:focus {
        top: 0;
      }
      :is(a, button, input, summary):focus-visible {
        outline: 3px solid var(--clay);
        outline-offset: 3px;
        border-radius: 8px;
      }

      .banner {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 0.625rem 1.5rem;
        font-size: 0.9375rem;
        color: var(--muted);
      }
      .banner a {
        color: var(--accent-text);
      }

      header {
        padding-block: 1.25rem;
      }
      .row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        min-height: 44px;
        color: var(--text);
        text-decoration: none;
        font-family: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
        font-size: 1.375rem;
        font-weight: 700;
      }
      header nav {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      header nav a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding-inline: 0.875rem;
        border-radius: 999px;
        color: var(--muted);
        font-weight: 600;
        text-decoration: none;
      }
      header nav a:hover {
        background: var(--surface);
        color: var(--text);
      }

      /* Serif display type is most of the warmth here. */
      h1,
      h2,
      h3 {
        font-family: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.15;
      }
      h1 {
        font-size: clamp(2.25rem, 1.6rem + 3vw, 3.5rem);
        margin: 0 0 1rem;
        max-width: 16ch;
      }
      .lede {
        font-size: 1.1875rem;
        color: var(--muted);
        max-width: 58ch;
        margin: 0 0 2rem;
      }

      .hero {
        padding-block: 2rem 4rem;
      }
      .hero__grid {
        display: grid;
        gap: 3rem;
        align-items: center;
        grid-template-columns: 1fr;
      }
      @media (min-width: 60rem) {
        .hero__grid {
          grid-template-columns: 1.35fr 0.65fr;
        }
      }
      .hero__art svg {
        width: 100%;
        max-width: 18rem;
        height: auto;
        display: block;
        margin-inline: auto;
      }

      .search {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        background: var(--paper);
        padding: 0.75rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        box-shadow: 0 10px 30px rgb(36 28 22 / 0.08);
      }
      .search input {
        flex: 1 1 16rem;
        min-width: 0;
        min-height: 52px;
        padding-inline: 1.25rem;
        font-size: 1.0625rem;
        font-family: inherit;
        color: var(--text);
        background: transparent;
        border: 0;
        border-radius: 999px;
      }
      .search input::placeholder {
        color: var(--muted);
        opacity: 1;
      }
      .search button {
        min-height: 52px;
        padding-inline: 1.75rem;
        font: 700 1.0625rem/1 inherit;
        color: var(--on-accent);
        background: var(--accent);
        border: 0;
        border-radius: 999px;
        cursor: pointer;
      }
      .search button:hover {
        background: #16402f;
      }
      .reassure {
        margin: 0.875rem 0 0;
        font-size: 1rem;
        color: var(--muted);
      }

      .band {
        padding-block: 1rem 3.5rem;
      }
      h2 {
        font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.125rem);
        margin: 0 0 1.25rem;
      }

      .urgent {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 2rem;
      }
      .urgent h2 {
        margin-top: 0;
      }
      .urgent p {
        color: var(--muted);
        margin: 0 0 1.25rem;
        max-width: 55ch;
      }
      .urgent__row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .urgent__row a {
        display: flex;
        align-items: baseline;
        gap: 0.625rem;
        min-height: 52px;
        padding: 0.75rem 1.25rem;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--text);
        text-decoration: none;
      }
      .urgent__row strong {
        font-family: Georgia, serif;
        font-size: 1.375rem;
      }
      .urgent__row span {
        color: var(--muted);
      }
      .urgent__row a:hover {
        border-color: var(--accent);
      }

      .cards {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1.25rem;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
      }
      .cards a {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        height: 100%;
        padding: 1.75rem;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 20px;
        color: var(--text);
        text-decoration: none;
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease;
      }
      .cards a:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 34px rgb(36 28 22 / 0.12);
      }
      .cards h3 {
        margin: 0;
        font-size: 1.375rem;
      }
      .cards p {
        margin: 0;
        color: var(--muted);
      }
      .go {
        margin-top: auto;
        padding-top: 0.75rem;
        color: var(--accent-text);
        font-weight: 700;
      }
      .more {
        margin-top: 1.75rem;
      }
      .more a {
        color: var(--accent-text);
        font-weight: 700;
        font-size: 1.0625rem;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }

      footer {
        background: var(--surface);
        border-top: 1px solid var(--border);
        padding-block: 2.5rem 3rem;
      }
      .foot-lede {
        color: var(--muted);
        max-width: 55ch;
        margin: 0;
      }
      footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        margin-top: 1rem;
      }
      footer nav a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--accent-text);
        font-weight: 600;
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
