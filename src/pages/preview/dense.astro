---
/**
 * Design direction 3 of 3 — "Dense & powerful".
 *
 * Premise: the heaviest users are not first-timers, they are people coming back
 * and the librarians, caseworkers and clinic staff helping someone at a desk.
 * For them a homepage is a wasted click, so the directory IS the homepage:
 * persistent filter rail, compact rows, everything visible at once.
 */
import { loadStats } from '../../lib/program-stats';
const { total, categories, programs } = loadStats();

const COUNTIES = [
  'alameda',
  'contra-costa',
  'marin',
  'napa',
  'san-francisco',
  'san-mateo',
  'santa-clara',
  'solano',
  'sonoma',
];
const label = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const rows = programs.slice(0, 40);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dense direction · Bay Navigator</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <a class="skip" href="#results">Skip to results</a>

    <div class="banner">
      Design preview 3 of 3 — <strong>Dense &amp; powerful</strong> ·
      <a href="/preview/utility">Utility</a> · <a href="/preview/warm">Warm</a>
    </div>

    <header>
      <a class="brand" href="/">
        <img src="/assets/images/logo/logo.webp" alt="" width="26" height="26" />
        Bay Navigator
      </a>
      <div class="omni">
        <label class="sr" for="q">Search programs</label>
        <input id="q" type="search" placeholder="Search 812 programs…" autocomplete="off" />
        <kbd>/</kbd>
      </div>
      <nav aria-label="Primary">
        <a href="/eligibility">Eligibility</a>
        <a href="/transit">Transit</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <div class="shell">
      <aside aria-label="Filters">
        <div class="rail">
          <section>
            <h2>County</h2>
            <ul>
              <li><label><input type="checkbox" checked /> <span>All counties</span></label></li>
              {
                COUNTIES.map((c) => (
                  <li>
                    <label>
                      <input type="checkbox" /> <span>{label(c)}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </section>

          <section>
            <h2>Category</h2>
            <ul>
              {
                categories.slice(0, 12).map((c) => (
                  <li>
                    <label>
                      <input type="checkbox" /> <span>{c.name}</span>
                      <b>{c.count}</b>
                    </label>
                  </li>
                ))
              }
            </ul>
          </section>

          <section>
            <h2>Who it's for</h2>
            <ul>
              {
                [
                  'Income eligible',
                  'Seniors 60+',
                  'Youth',
                  'Veterans',
                  'Disabled',
                  'Immigrants',
                ].map((g) => (
                  <li>
                    <label>
                      <input type="checkbox" /> <span>{g}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>
      </aside>

      <main id="results">
        <div class="toolbar">
          <p class="count"><strong>{total.toLocaleString()}</strong> programs</p>
          <div class="tools">
            <label class="sr" for="sort">Sort</label>
            <select id="sort">
              <option>Relevance</option>
              <option>Name A–Z</option>
              <option>Recently verified</option>
            </select>
            <div class="seg" role="group" aria-label="Density">
              <button type="button" aria-pressed="true">Compact</button>
              <button type="button" aria-pressed="false">Comfortable</button>
            </div>
          </div>
        </div>

        <ol class="rows">
          {
            rows.map((p) => (
              <li>
                <a href={`/programs/${p.id}`}>
                  <span class="nm">{p.name}</span>
                  <span class="meta">
                    <span class="tag">{p.category}</span>
                    <span class="area">{p.area || '—'}</span>
                  </span>
                  <span class="desc">{p.description.slice(0, 116)}…</span>
                  <span class="contact">{p.phone || (p.link ? 'Website' : '—')}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="more">Showing {rows.length} of {total.toLocaleString()} · scroll for more</p>
      </main>
    </div>

    <style is:global>
      /* Palette verified: 18.9:1 body, 10.6:1 links, 8.4:1 buttons (AAA + APCA). */
      :root {
        --bg: #ffffff;
        --surface: #f7f8fa;
        --text: #0d1117;
        --muted: #3b434d;
        --accent: #0b4f8a;
        --accent-text: #08406f;
        --border: #6a737d;
        --hair: #d7dce1;
        --on-accent: #ffffff;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font:
          400 0.9375rem/1.55 ui-sans-serif,
          system-ui,
          -apple-system,
          'Segoe UI',
          Arial,
          sans-serif;
      }
      .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }
      .skip {
        position: absolute;
        left: 1rem;
        top: -4rem;
        background: var(--accent);
        color: var(--on-accent);
        padding: 0.75rem 1rem;
        z-index: 20;
      }
      .skip:focus {
        top: 0;
      }
      :is(a, button, input, select):focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
      }

      .banner {
        background: var(--surface);
        border-bottom: 1px solid var(--hair);
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
        color: var(--muted);
      }
      .banner a {
        color: var(--accent-text);
      }

      header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.625rem 1rem;
        border-bottom: 1px solid var(--hair);
        position: sticky;
        top: 0;
        background: var(--bg);
        z-index: 10;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 44px;
        color: var(--text);
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
      }
      .omni {
        position: relative;
        flex: 1 1 auto;
        max-width: 36rem;
      }
      .omni input {
        width: 100%;
        min-height: 44px;
        padding: 0 2.5rem 0 0.875rem;
        font: inherit;
        color: var(--text);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
      }
      .omni kbd {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        font:
          600 0.75rem/1 ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;
        color: var(--muted);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.25rem 0.375rem;
      }
      header nav {
        display: flex;
        gap: 0.25rem;
      }
      header nav a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding-inline: 0.75rem;
        border-radius: 6px;
        color: var(--muted);
        font-weight: 600;
        text-decoration: none;
      }
      header nav a:hover {
        background: var(--surface);
        color: var(--text);
      }

      .shell {
        display: grid;
        grid-template-columns: 1fr;
      }
      @media (min-width: 60rem) {
        .shell {
          grid-template-columns: 17rem 1fr;
        }
        aside {
          border-right: 1px solid var(--hair);
        }
        .rail {
          position: sticky;
          top: 4.25rem;
          max-height: calc(100vh - 4.25rem);
          overflow: auto;
        }
      }
      .rail {
        padding: 1.25rem 1rem 3rem;
      }
      .rail section + section {
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--hair);
      }
      .rail h2 {
        margin: 0 0 0.5rem;
        font-size: 0.8125rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .rail ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .rail label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 44px;
        cursor: pointer;
        border-radius: 6px;
        padding-inline: 0.25rem;
      }
      .rail label:hover {
        background: var(--surface);
      }
      .rail input {
        width: 20px;
        height: 20px;
        accent-color: var(--accent);
        flex: 0 0 auto;
      }
      .rail span {
        flex: 1 1 auto;
      }
      .rail b {
        color: var(--muted);
        font-weight: 400;
        font-variant-numeric: tabular-nums;
        font-size: 0.875rem;
      }

      .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--hair);
        position: sticky;
        top: 4.25rem;
        background: var(--bg);
        z-index: 5;
      }
      .count {
        margin: 0;
        color: var(--muted);
      }
      .count strong {
        color: var(--text);
        font-variant-numeric: tabular-nums;
      }
      .tools {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      select {
        min-height: 44px;
        font: inherit;
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding-inline: 0.5rem;
      }
      .seg {
        display: flex;
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
      }
      .seg button {
        min-height: 44px;
        padding-inline: 0.75rem;
        font: 600 0.875rem/1 inherit;
        color: var(--muted);
        background: var(--bg);
        border: 0;
        cursor: pointer;
      }
      .seg button[aria-pressed='true'] {
        background: var(--accent);
        color: var(--on-accent);
      }

      /* Rows, not cards. Four aligned columns scan far faster than 40 boxes. */
      .rows {
        list-style: none;
        margin: 0;
        padding: 0;
        counter-reset: r;
      }
      .rows li + li {
        border-top: 1px solid var(--hair);
      }
      .rows a {
        display: grid;
        gap: 0.125rem 1rem;
        align-items: baseline;
        min-height: 44px;
        padding: 0.75rem 1.25rem;
        color: inherit;
        text-decoration: none;
        grid-template-columns: 1fr;
      }
      @media (min-width: 60rem) {
        .rows a {
          grid-template-columns: 20rem 11rem 1fr 9rem;
        }
      }
      .rows a:hover {
        background: var(--surface);
      }
      .nm {
        font-weight: 650;
        color: var(--accent-text);
      }
      .meta {
        display: flex;
        gap: 0.5rem;
        align-items: baseline;
        font-size: 0.875rem;
        color: var(--muted);
      }
      .tag {
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.0625rem 0.375rem;
        white-space: nowrap;
      }
      .desc {
        color: var(--muted);
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
      }
      .contact {
        color: var(--muted);
        font-variant-numeric: tabular-nums;
        font-size: 0.875rem;
      }
      .more {
        padding: 1rem 1.25rem 3rem;
        color: var(--muted);
      }
    </style>
  </body>
</html>
